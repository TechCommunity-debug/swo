---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SearchBox from '../components/SearchBox.astro';
import EntryCard from '../components/EntryCard.astro';
import JsonLd from '../components/JsonLd.astro';
import {
  byTerm,
  categoryPath,
  countriesById,
  countryPath,
  entryPath,
  splitEntryId,
  type Entry,
} from '../lib/urls';
import { CATEGORIES, REGION_GROUPS } from '../data/taxonomy';
import { homeSeo, SITE_NAME, SITE_TAGLINE, SITE_URL } from '../lib/seo';

const countries = (await getCollection('countries')).sort((a, b) => a.data.order - b.data.order);
const byId = countriesById(countries);
const entries = await getCollection('entries', (e) => e.data.status === 'published');

const countsByCountry = new Map<string, number>();
for (const e of entries) {
  const [cid] = splitEntryId(e.id);
  countsByCountry.set(cid, (countsByCountry.get(cid) ?? 0) + 1);
}

const grouped = REGION_GROUPS.map((group) => ({
  ...group,
  countries: countries.filter((c) => c.data.regionGroup === group.id),
})).filter((g) => g.countries.length > 0);

const href = (e: Entry) => {
  const [cid, slug] = splitEntryId(e.id);
  return entryPath(byId.get(cid)!.data.urlSlug, slug);
};

// Featured band: one term per country, picked for editorial depth rather than
// shuffled, so the home page shows the site at its best and stays stable.
const depth = (e: Entry) =>
  e.data.definitions.length + e.data.examples.length + (e.data.origin ? 3 : 0);
const featured = countries
  .map((c) =>
    entries
      .filter((e) => splitEntryId(e.id)[0] === c.id)
      .sort((a, b) => depth(b) - depth(a) || byTerm(a, b))
      .at(0),
  )
  .filter((e): e is Entry => Boolean(e));

// Category counts across every country — the cross-country comparison is the
// thing this site does that a single-country glossary cannot.
const categoryCounts = new Map<string, number>();
for (const e of entries) for (const c of e.data.categories) {
  categoryCounts.set(c, (categoryCounts.get(c) ?? 0) + 1);
}
const categoryCards = CATEGORIES.map((c) => ({ ...c, count: categoryCounts.get(c.id) ?? 0 }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 6);

const seo = homeSeo();

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    name: SITE_NAME,
    alternateName: SITE_TAGLINE,
    url: `${SITE_URL}/`,
    inLanguage: 'en',
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: `${SITE_URL}/search/?q={search_term_string}` },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: SITE_NAME,
    url: `${SITE_URL}/`,
  },
];
---

<Layout title={seo.title} description={seo.description}>
  <JsonLd slot="head" schema={schema} />

  <section class="border-b border-hairline-soft bg-canvas">
    <div class="container-site py-16 lg:py-24">
      <div class="max-w-3xl">
        <h1 class="text-display-lg text-ink sm:text-display-xl">
          The global guide to slang
        </h1>
        <p class="mt-5 max-w-2xl text-body-md text-mute sm:text-heading-md sm:font-normal">
          {entries.length} informal words and phrases from {countries.length} countries — what they
          mean, how to say them, and the situations where using them would be a mistake.
        </p>
        <div class="mt-8 max-w-2xl">
          <SearchBox />
        </div>
        <p class="mt-3 text-body-sm text-mute">
          Try <a
            href="/mexican-slang/chido/"
            class="focus-ring rounded-sm font-semibold text-ink-soft hover:underline">chido</a
          >, <a
            href="/british-slang/knackered/"
            class="focus-ring rounded-sm font-semibold text-ink-soft hover:underline">knackered</a
          >, or <a
            href="/french-slang/verlan/"
            class="focus-ring rounded-sm font-semibold text-ink-soft hover:underline">verlan</a
          >.
        </p>
      </div>
    </div>
  </section>

  <div class="container-site py-section">
    <section aria-labelledby="countries">
      <h2 id="countries" class="text-heading-xl text-ink">Pick a country</h2>
      <div class="mt-8 grid gap-10">
        {
          grouped.map((group) => (
            <div>
              <h3 class="text-caption font-semibold tracking-wide text-mute uppercase">
                {group.name}
              </h3>
              <ul class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
                {group.countries.map((c) => (
                  <li>
                    <a
                      href={countryPath(c)}
                      class="focus-ring flex h-full flex-col gap-1 rounded-md bg-canvas p-5 ring-1 ring-hairline-soft hover:bg-surface-card"
                    >
                      <span class="text-heading-lg" aria-hidden="true">
                        {c.data.flagEmoji}
                      </span>
                      <span class="text-heading-md text-ink">{c.data.adjective} slang</span>
                      <span class="text-body-sm text-mute">
                        {countsByCountry.get(c.id) ?? 0} terms · {c.data.languageName}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-section" aria-labelledby="categories">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <div class="max-w-2xl">
          <h2 id="categories" class="text-heading-xl text-ink">Or pick a meaning</h2>
          <p class="mt-2 text-body-md text-mute">
            Every language builds slang around the same handful of things. These pages line the
            words up side by side — <span lang="es-MX">chido</span>, <span lang="en-GB">mint</span>{' '}
            and <span lang="it-IT">figo</span> all doing the same job in three countries.
          </p>
        </div>
        <a
          href="/categories/"
          class="focus-ring rounded-sm text-body-md font-semibold text-ink-soft hover:underline"
          >All categories</a
        >
      </div>
      <ul class="mt-8 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {
          categoryCards.map((c) => (
            <li>
              <a
                href={categoryPath(c.urlSlug)}
                class="focus-ring flex h-full flex-col rounded-md bg-surface-card p-5 hover:bg-surface-sunk"
              >
                <span class="text-heading-md text-ink">{c.name}</span>
                <span class="mt-1 text-caption text-mute">{c.count} terms</span>
                <span class="mt-3 line-clamp-3 text-body-sm text-charcoal">{c.description}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-section" aria-labelledby="featured">
      <h2 id="featured" class="text-heading-xl text-ink">One word from each country</h2>
      <p class="mt-2 max-w-2xl text-body-md text-mute">
        A sample of what a full entry looks like — definitions, worked examples with translations,
        and the origin where it is actually known.
      </p>
      <div class="masonry mt-8">
        {
          featured.map((e) => {
            const country = byId.get(splitEntryId(e.id)[0])!;
            return (
              <EntryCard
                entry={e}
                href={href(e)}
                lang={country.data.languageCode}
                countryLabel={country.data.adjective}
                flagEmoji={country.data.flagEmoji}
              />
            );
          })
        }
      </div>
    </section>

    <section
      class="mt-section grid gap-6 rounded-lg bg-canvas p-8 ring-1 ring-hairline-soft lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] lg:items-center lg:p-12"
      aria-labelledby="editorial"
    >
      <div>
        <h2 id="editorial" class="text-heading-xl text-ink">
          Every entry is written, not generated
        </h2>
        <p class="mt-4 text-body-md text-body">
          A slang dictionary is only worth anything if it tells you the things a translation app
          cannot: whether a word is affectionate or hostile, who you can say it to, and whether the
          origin story everyone repeats is actually true. Where something is disputed, we say it is
          disputed. Where a word is a slur, we say that too, and list it anyway — because you still
          need to understand it when you hear it.
        </p>
      </div>
      <a
        href="/about/"
        class="focus-ring inline-flex h-10 w-fit items-center rounded-md bg-primary px-4 text-body-sm font-bold text-on-primary hover:bg-primary-pressed"
        >How we source definitions</a
      >
    </section>
  </div>
</Layout>
