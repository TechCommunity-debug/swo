---
import NotFoundPage from '../components/pages/NotFoundPage.astro';
---

<NotFoundPage locale="en" />

<script is:inline>
  (function () {
    var p = window.location.pathname;
    var m = p.match(/^\/(es|pt|fr|de|it|ru|ja|ko)(\/|$)/);
    if (m && m[1]) {
      var target = '/' + m[1] + '/404/';
      if (p !== target) {
        window.location.replace(target);
      }
    }
  })();
</script>
