---
import ServerErrorPage from '../components/pages/ServerErrorPage.astro';

interface Props {
  error?: unknown;
}

const { error } = Astro.props;
---

<ServerErrorPage locale="en" error={error} />

<script is:inline>
  (function () {
    var p = window.location.pathname;
    var m = p.match(/^\/(es|pt|fr|de|it|ru|ja|ko)(\/|$)/);
    if (m && m[1]) {
      var target = '/' + m[1] + '/500/';
      if (p !== target) {
        window.location.replace(target);
      }
    }
  })();
</script>
