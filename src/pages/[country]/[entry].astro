---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import JsonLd from '../../components/JsonLd.astro';
import {
  byTerm,
  categoryPath,
  countriesById,
  countryPath,
  entryPath,
  splitEntryId,
  type Country,
  type Entry,
} from '../../lib/urls';
import { CATEGORY_BY_ID, REGISTER_LABEL, USAGE_WARNING_LABEL } from '../../data/taxonomy';
import { entrySeo, SITE_URL } from '../../lib/seo';

type Neighbour = { term: string; href: string } | null;
type Link = { term: string; href: string; lang: string; note?: string };

export async function getStaticPaths() {
  const countries = await getCollection('countries');
  const byId = countriesById(countries);
  const all = await getCollection('entries', (e) => e.data.status === 'published');

  // Group and sort ONCE. Everything each page needs is computed here and passed
  // as props — the page body never calls getCollection(). At 10k entries the
  // alternative is 10k full-collection scans, and it cannot be retrofitted.
  const byCountry = new Map<string, Entry[]>();
  for (const e of all) {
    const [cid] = splitEntryId(e.id);
    const list = byCountry.get(cid);
    if (list) list.push(e);
    else byCountry.set(cid, [e]);
  }
  for (const list of byCountry.values()) list.sort(byTerm);

  const entryById = new Map(all.map((e) => [e.id, e]));
  const href = (e: Entry) => {
    const [cid, slug] = splitEntryId(e.id);
    return entryPath(byId.get(cid)!.data.urlSlug, slug);
  };

  return [...byCountry].flatMap(([countryId, list]) => {
    const country = byId.get(countryId)!;
    return list.map((entry, i) => {
      const [, termSlug] = splitEntryId(entry.id);

      // Curated related terms only, capped at six, never backfilled.
      const related: Link[] = (entry.data.relatedTerms ?? [])
        .slice(0, 6)
        .map((ref) => entryById.get(ref.id))
        .filter((e): e is Entry => Boolean(e))
        .map((e) => ({
          term: e.data.term,
          href: href(e),
          lang: byId.get(splitEntryId(e.id)[0])!.data.languageCode,
        }));

      // Same country + shares a category. Ranked by how many categories overlap
      // and then by editorial depth — taking the alphabetically-first five would
      // be arbitrary, which is the thing this module is supposed to avoid
      // looking like. Curated relatedTerms are excluded so nothing repeats.
      const relatedIds = new Set(entry.data.relatedTerms?.map((r) => r.id));
      const overlap = (e: Entry) =>
        e.data.categories.filter((c) => entry.data.categories.includes(c)).length;
      const depth = (e: Entry) =>
        e.data.definitions.length + e.data.examples.length + (e.data.origin ? 2 : 0);
      const sameCategory: Link[] = list
        .filter((e) => e.id !== entry.id && !relatedIds.has(e.id) && overlap(e) > 0)
        .sort((a, b) => overlap(b) - overlap(a) || depth(b) - depth(a))
        .slice(0, 5)
        .map((e) => ({ term: e.data.term, href: href(e), lang: country.data.languageCode }));

      const alsoUsedIn = (entry.data.alsoUsedIn ?? [])
        .map((ref) => byId.get(ref.id))
        .filter((c): c is Country => Boolean(c))
        .map((c) => ({ adjective: c.data.adjective, flag: c.data.flagEmoji, href: countryPath(c) }));

      const prev: Neighbour = list[i - 1]
        ? { term: list[i - 1]!.data.term, href: href(list[i - 1]!) }
        : null;
      const next: Neighbour = list[i + 1]
        ? { term: list[i + 1]!.data.term, href: href(list[i + 1]!) }
        : null;

      return {
        params: { country: country.data.urlSlug, entry: termSlug },
        props: { entry, country, prev, next, related, sameCategory, alsoUsedIn },
      };
    });
  });
}

interface Props {
  entry: Entry;
  country: Country;
  prev: Neighbour;
  next: Neighbour;
  related: Link[];
  sameCategory: Link[];
  alsoUsedIn: { adjective: string; flag: string; href: string }[];
}

const { entry, country, prev, next, related, sameCategory, alsoUsedIn } = Astro.props;
const d = entry.data;
const c = country.data;
const lang = c.languageCode;
const isEnglish = lang.startsWith('en');

const seo = entrySeo(d, c);
const pageUrl = new URL(Astro.url.pathname, SITE_URL).href;
const countryUrl = new URL(countryPath(country), SITE_URL).href;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'DefinedTerm',
    '@id': `${pageUrl}#term`,
    name: d.term,
    description: d.definitions[0].text,
    inDefinedTermSet: { '@id': `${countryUrl}#termset` },
    url: pageUrl,
    inLanguage: lang,
    ...(d.variants.length > 0 ? { alternateName: d.variants } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: `${c.adjective} slang`, item: countryUrl },
      { '@type': 'ListItem', position: 3, name: d.term, item: pageUrl },
    ],
  },
];
---

<Layout title={seo.title} description={seo.description} ogType="article">
  <JsonLd slot="head" schema={schema} />

  <div class="container-site py-8 lg:py-12">
    <Breadcrumbs
      items={[
        { label: `${c.adjective} slang`, href: countryPath(country) },
        { label: d.term },
      ]}
    />

    <div class="mt-8 grid gap-12 lg:grid-cols-[minmax(0,1fr)_18rem]">
      <article>
        <header>
          <h1 class="text-display-lg text-ink" lang={lang}>{d.term}</h1>

          <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-body-sm text-mute">
            {
              d.pronunciation?.respelling && (
                <span class="text-body-md text-charcoal">{d.pronunciation.respelling}</span>
              )
            }
            {d.pronunciation?.ipa && <span class="font-mono">{d.pronunciation.ipa}</span>}
            <span class="italic">{d.partOfSpeech.join(', ')}</span>
            <span
              class="rounded-full bg-surface-card px-2.5 py-1 text-caption font-medium text-charcoal not-italic"
              >{REGISTER_LABEL[d.register]}</span
            >
            {d.region && d.region !== 'General' && (
              <span class="rounded-full bg-surface-card px-2.5 py-1 text-caption font-medium text-charcoal">
                {d.region}
              </span>
            )}
          </p>

          <p class="mt-4 text-body-md text-mute">
            A {c.languageName} slang term. <a
              href={countryPath(country)}
              class="focus-ring rounded-sm font-semibold text-ink-soft hover:underline"
              >Browse all {c.adjective} slang</a
            >.
          </p>
        </header>

        {
          d.usageWarning.length > 0 && (
            <aside
              class="mt-8 rounded-md bg-warn-pale p-5 text-warn-deep"
              aria-labelledby="usage-warning"
            >
              <h2 id="usage-warning" class="text-body-strong font-bold">
                Before you use this one
              </h2>
              <ul class="mt-2 grid gap-1 text-body-sm">
                {d.usageWarning.map((w) => (
                  <li>{USAGE_WARNING_LABEL[w]}</li>
                ))}
              </ul>
            </aside>
          )
        }

        <section class="mt-10" aria-labelledby="meaning">
          <h2 id="meaning" class="text-heading-xl text-ink">What it means</h2>
          <ol class="mt-4 grid gap-5">
            {
              d.definitions.map((def, i) => (
                <li class="grid grid-cols-[1.75rem_minmax(0,1fr)] gap-x-2">
                  <span class="pt-0.5 text-body-sm font-bold text-ash" aria-hidden="true">
                    {i + 1}.
                  </span>
                  <div>
                    <p class="text-body-md text-body">{def.text}</p>
                    {def.note && <p class="mt-1 text-body-sm text-mute">{def.note}</p>}
                  </div>
                </li>
              ))
            }
          </ol>

          {
            d.literalMeaning && (
              <p class="mt-5 rounded-md bg-surface-card p-4 text-body-sm text-charcoal">
                <span class="font-semibold text-ink">Literally:</span> {d.literalMeaning}
              </p>
            )
          }
        </section>

        <section class="mt-10" aria-labelledby="examples">
          <h2 id="examples" class="text-heading-xl text-ink">
            {isEnglish ? 'In use' : 'Examples with translations'}
          </h2>
          <ul class="mt-4 grid gap-5">
            {
              d.examples.map((ex) => (
                <li class="border-l-2 border-hairline pl-4">
                  <p class="text-body-md text-ink" lang={lang}>
                    {ex.text}
                  </p>
                  {!isEnglish && <p class="mt-1 text-body-sm text-mute">{ex.translation}</p>}
                  {ex.context && (
                    <p class="mt-2 text-body-sm text-charcoal">
                      <span class="font-semibold">Note:</span> {ex.context}
                    </p>
                  )}
                </li>
              ))
            }
          </ul>
        </section>

        {
          d.origin && (
            <section class="mt-10" aria-labelledby="origin">
              <h2 id="origin" class="text-heading-xl text-ink">Where it comes from</h2>
              <p class="mt-4 text-body-md text-body">{d.origin.etymology}</p>
              {d.origin.firstAttested && (
                <p class="mt-2 text-body-sm text-mute">
                  First attested: {d.origin.firstAttested}
                </p>
              )}
              {d.origin.sources.length > 0 && (
                <ul class="mt-3 grid gap-1 text-body-sm">
                  {d.origin.sources.map((s) => (
                    <li>
                      <a
                        href={s.url}
                        rel="noopener"
                        class="focus-ring rounded-sm text-ink-soft hover:underline"
                      >
                        {s.title}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          )
        }

        {
          (d.variants.length > 0 || d.synonyms.length > 0) && (
            <section class="mt-10" aria-labelledby="forms">
              <h2 id="forms" class="text-heading-xl text-ink">Other forms</h2>
              <dl class="mt-4 grid gap-3 text-body-md">
                {d.variants.length > 0 && (
                  <div class="flex flex-wrap gap-x-2">
                    <dt class="font-semibold text-ink">Spellings and variants:</dt>
                    <dd class="text-body" lang={lang}>
                      {d.variants.join(', ')}
                    </dd>
                  </div>
                )}
                {d.synonyms.length > 0 && (
                  <div class="flex flex-wrap gap-x-2">
                    <dt class="font-semibold text-ink">Similar terms:</dt>
                    <dd class="text-body" lang={lang}>
                      {d.synonyms.join(', ')}
                    </dd>
                  </div>
                )}
              </dl>
            </section>
          )
        }

        <nav
          aria-label="Nearby terms"
          class="mt-12 flex items-stretch justify-between gap-4 border-t border-hairline pt-6"
        >
          {
            prev ? (
              <a
                href={prev.href}
                rel="prev"
                class="focus-ring group max-w-[45%] rounded-md p-2 text-left hover:bg-surface-card"
              >
                <span class="block text-caption text-mute">Previous</span>
                <span class="text-body-strong text-ink group-hover:underline" lang={lang}>
                  {prev.term}
                </span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a
                href={next.href}
                rel="next"
                class="focus-ring group ml-auto max-w-[45%] rounded-md p-2 text-right hover:bg-surface-card"
              >
                <span class="block text-caption text-mute">Next</span>
                <span class="text-body-strong text-ink group-hover:underline" lang={lang}>
                  {next.term}
                </span>
              </a>
            )
          }
        </nav>
      </article>

      <aside class="grid content-start gap-8 lg:sticky lg:top-32">
        {
          related.length > 0 && (
            <section aria-labelledby="related">
              <h2 id="related" class="text-heading-md text-ink">Related terms</h2>
              <ul class="mt-3 grid gap-2">
                {related.map((r) => (
                  <li>
                    <a
                      href={r.href}
                      class="focus-ring rounded-sm text-body-md text-ink-soft hover:underline"
                      lang={r.lang}
                    >
                      {r.term}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          alsoUsedIn.length > 0 && (
            <section aria-labelledby="also-used">
              <h2 id="also-used" class="text-heading-md text-ink">Also used in</h2>
              <ul class="mt-3 grid gap-2">
                {alsoUsedIn.map((a) => (
                  <li>
                    <a
                      href={a.href}
                      class="focus-ring rounded-sm text-body-md text-ink-soft hover:underline"
                    >
                      <span aria-hidden="true">{a.flag}</span> {a.adjective} slang
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <section aria-labelledby="categories">
          <h2 id="categories" class="text-heading-md text-ink">Categories</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {
              d.categories.map((id) => {
                const cat = CATEGORY_BY_ID.get(id)!;
                return (
                  <li>
                    <a
                      href={categoryPath(cat.urlSlug)}
                      class="focus-ring inline-flex rounded-full bg-surface-card px-3 py-1.5 text-body-sm font-semibold text-ink hover:bg-surface-sunk"
                    >
                      {cat.name}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </section>

        {
          sameCategory.length > 0 && (
            <section aria-labelledby="same-category">
              <h2 id="same-category" class="text-heading-md text-ink">
                More {c.adjective} terms like this
              </h2>
              <ul class="mt-3 grid gap-2">
                {sameCategory.map((r) => (
                  <li>
                    <a
                      href={r.href}
                      class="focus-ring rounded-sm text-body-md text-ink-soft hover:underline"
                      lang={r.lang}
                    >
                      {r.term}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <p class="border-t border-hairline pt-4 text-caption text-mute">
          {d.reviewedBy && <>Reviewed by {d.reviewedBy}. </>}Updated {
            d.updatedDate.toLocaleDateString('en-GB', {
              day: 'numeric',
              month: 'long',
              year: 'numeric',
            })
          }. <a href="/about/" class="focus-ring rounded-sm underline hover:text-ink"
            >How we source definitions</a
          >.
        </p>
      </aside>
    </div>
  </div>
</Layout>
