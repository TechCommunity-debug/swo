---
import { aboutPath, browsePath, categoryPath, contactPath, countryPath, privacyPath, searchPath, termsPath } from '../lib/urls';
import { categoriesFor, countriesFor, entriesFor, loadSite } from '../lib/site';
import { localizeCountry } from '../lib/localize';
import { localizeCategory } from '../data/taxonomy';
import { DEFAULT_LOCALE, type Locale } from '../data/locales';
import { t } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const strings = t(locale);

const site = await loadSite();
const countries = countriesFor(site, locale);

/**
 * The footer's middle column is country × topic pages, not a category index —
 * there is no longer any such thing as a standalone category page, and a
 * "People" link that isn't attached to a country would have nowhere to go.
 *
 * One topic per country, the biggest each country has, so the column spreads
 * across the site rather than stacking six Mexican links. A footer that lists
 * everything is the clearest signal a site was generated rather than built.
 */
const topics = countries
  .map((country) => {
    const entries = entriesFor(site, country.id, locale);
    const top = categoriesFor(entries).sort((a, b) => b.count - a.count)[0];
    if (!top) return null;
    const c = localizeCountry(country, locale);
    const cat = localizeCategory(top.category, locale);
    return {
      href: categoryPath(c.urlSlug, cat.urlSlug, locale),
      label: strings.slangFor(c.adjective, cat.topic),
    };
  })
  .filter((x): x is { href: string; label: string } => Boolean(x))
  .slice(0, 6);

const year = new Date().getFullYear();
const linkClass =
  'focus-ring rounded-sm text-body-sm text-mute hover:text-ink hover:underline';
---

<footer class="mt-section border-t border-hairline bg-canvas">
  <div class="container-site py-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="text-heading-md text-ink">
          <span class="text-primary">Slang</span>WordsOnline
        </p>
        <p class="mt-2 max-w-xs text-body-sm text-mute">{strings.footerTagline}</p>
      </div>

      <nav aria-labelledby="footer-countries">
        <h2 id="footer-countries" class="text-body-sm font-bold text-ink">
          {strings.byCountry}
        </h2>
        <ul class="mt-3 grid gap-2">
          {
            countries.map((country) => {
              const c = localizeCountry(country, locale);
              return (
                <li>
                  <a href={countryPath(country, locale)} class={linkClass}>
                    {strings.countrySlang(c.adjective)}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <nav aria-labelledby="footer-topics">
        <h2 id="footer-topics" class="text-body-sm font-bold text-ink">
          {strings.popularTopics}
        </h2>
        <ul class="mt-3 grid gap-2">
          {
            topics.map((topic) => (
              <li>
                <a href={topic.href} class={linkClass}>
                  {topic.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="footer-site">
        <h2 id="footer-site" class="text-body-sm font-bold text-ink">{strings.thisSite}</h2>
        <ul class="mt-3 grid gap-2">
          <li><a href={browsePath(locale)} class={linkClass}>{strings.browse}</a></li>
          <li><a href={searchPath(locale)} class={linkClass}>{strings.search}</a></li>
          <li><a href={aboutPath(locale)} class={linkClass}>{strings.aboutUs}</a></li>
          <li><a href={contactPath(locale)} class={linkClass}>{strings.contactUs}</a></li>
          <li><a href={privacyPath(locale)} class={linkClass}>{strings.privacyPolicy}</a></li>
          <li><a href={termsPath(locale)} class={linkClass}>{strings.termsConditions}</a></li>
        </ul>
      </nav>
    </div>

    <div
      class="mt-10 flex flex-col gap-2 border-t border-hairline-soft pt-6 text-caption text-mute sm:flex-row sm:items-center sm:justify-between"
    >
      <p>{strings.copyright(year)}</p>
      <p>{strings.footerNote}</p>
    </div>
  </div>
</footer>
