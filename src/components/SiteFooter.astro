---
import { getCollection } from 'astro:content';
import { countryPath, categoryPath } from '../lib/urls';
import { CATEGORIES } from '../data/taxonomy';
import { SITE_TAGLINE } from '../lib/seo';

const countries = (await getCollection('countries')).sort(
  (a, b) => a.data.order - b.data.order,
);
// Four categories, not eleven. A footer that lists everything is the clearest
// signal a site was generated rather than built.
const footerCategories = CATEGORIES.slice(0, 4);
const year = new Date().getFullYear();
---

<footer class="mt-section border-t border-hairline bg-canvas">
  <div class="container-site py-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="text-heading-md text-ink">
          <span class="text-primary">Slang</span>WordsOnline
        </p>
        <p class="mt-2 max-w-xs text-body-sm text-mute">{SITE_TAGLINE}</p>
      </div>

      <nav aria-labelledby="footer-countries">
        <h2 id="footer-countries" class="text-body-sm font-bold text-ink">By country</h2>
        <ul class="mt-3 grid gap-2">
          {
            countries.map((c) => (
              <li>
                <a
                  href={countryPath(c)}
                  class="focus-ring rounded-sm text-body-sm text-mute hover:text-ink hover:underline"
                >
                  {c.data.adjective} slang
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-labelledby="footer-categories">
        <h2 id="footer-categories" class="text-body-sm font-bold text-ink">By category</h2>
        <ul class="mt-3 grid gap-2">
          {
            footerCategories.map((c) => (
              <li>
                <a
                  href={categoryPath(c.urlSlug)}
                  class="focus-ring rounded-sm text-body-sm text-mute hover:text-ink hover:underline"
                >
                  {c.name}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="/categories/"
              class="focus-ring rounded-sm text-body-sm text-mute hover:text-ink hover:underline"
              >All categories</a
            >
          </li>
        </ul>
      </nav>

      <nav aria-labelledby="footer-site">
        <h2 id="footer-site" class="text-body-sm font-bold text-ink">This site</h2>
        <ul class="mt-3 grid gap-2">
          <li>
            <a href="/about/" class="focus-ring rounded-sm text-body-sm text-mute hover:text-ink hover:underline"
              >How we source definitions</a
            >
          </li>
          <li>
            <a href="/browse/" class="focus-ring rounded-sm text-body-sm text-mute hover:text-ink hover:underline"
              >Browse every term A–Z</a
            >
          </li>
          <li>
            <a href="/search/" class="focus-ring rounded-sm text-body-sm text-mute hover:text-ink hover:underline"
              >Search</a
            >
          </li>
        </ul>
      </nav>
    </div>

    <div
      class="mt-10 flex flex-col gap-2 border-t border-hairline-soft pt-6 text-caption text-mute sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} Slang Words Online</p>
      <p>
        Definitions are written and reviewed by people. Where an origin is disputed, we say so.
      </p>
    </div>
  </div>
</footer>
