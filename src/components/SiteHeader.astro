---
import SearchBox from './SearchBox.astro';
import LocaleSwitcher from './LocaleSwitcher.astro';
import Flag from './Flag.astro';
import { browsePath, countryPath, homePath } from '../lib/urls';
import { countriesFor, loadSite, type Alternate } from '../lib/site';
import { localizeCountry } from '../lib/localize';
import { DEFAULT_LOCALE, type Locale } from '../data/locales';
import { t } from '../i18n/ui';

interface Props {
  locale?: Locale;
  /** Passed through so the switcher can jump to *this* page in the other language. */
  alternates?: Alternate[];
}

const { locale = DEFAULT_LOCALE, alternates = [] } = Astro.props;
const strings = t(locale);

// Only countries that have readable content in this locale appear in the
// chrome. A `/es/` nav listing eight countries where seven lead nowhere would
// be worse than a short one that is honest about its coverage.
const site = await loadSite();
const countries = countriesFor(site, locale).map((c) => ({
  href: countryPath(c, locale),
  ...localizeCountry(c, locale),
}));

const current = Astro.url.pathname;
const isCurrent = (href: string) => (current.startsWith(href) ? 'page' : undefined);
---

<header class="sticky top-0 z-40 border-b border-hairline bg-canvas">
  <div class="container-site flex h-16 items-center justify-center gap-4 md:justify-between">
    <a
      href={homePath(locale)}
      class="focus-ring -mx-1 flex shrink-0 items-center gap-2 rounded-md px-1 text-heading-md tracking-[-0.5px] text-ink"
    >
      <img src="/favicon.svg" alt="" class="h-8 w-8 shrink-0" />
      <span class="text-primary">Slang</span>WordsOnline
    </a>

    <div class="ml-auto hidden max-w-md flex-1 md:block">
      <SearchBox compact locale={locale} />
    </div>

    <nav aria-label={strings.mainNav} class="ml-auto hidden items-center gap-1 md:ml-0 md:flex">
      <a
        href={browsePath(locale)}
        aria-current={isCurrent(browsePath(locale))}
        class="focus-ring rounded-md px-3 py-2 text-body-sm font-semibold text-ink aria-[current=page]:text-primary hover:bg-surface-card"
        >{strings.browse}</a
      >
      <button
        type="button"
        class="theme-toggle focus-ring flex size-9 shrink-0 items-center justify-center rounded-full text-ink hover:bg-surface-card"
        aria-pressed="false"
      >
        <svg
          viewBox="0 0 24 24"
          class="size-5 [[data-theme=dark]_&]:hidden"
          data-icon="sun"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
          ></path>
        </svg>
        <svg
          viewBox="0 0 24 24"
          class="hidden size-5 [[data-theme=dark]_&]:block"
          data-icon="moon"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
      <LocaleSwitcher locale={locale} alternates={alternates} />
    </nav>

    <!-- Mobile: a details/summary drawer. No JS needed for the core nav. -->
    <details class="group relative ml-auto md:hidden">
      <summary
        class="focus-ring flex size-10 cursor-pointer list-none items-center justify-center rounded-full bg-surface-card [&::-webkit-details-marker]:hidden"
        aria-label={strings.openMenu}
      >
        <svg
          viewBox="0 0 24 24"
          class="size-5 group-open:hidden"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
        <svg
          viewBox="0 0 24 24"
          class="hidden size-5 group-open:block"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </summary>
      <div
        class="fixed inset-x-0 top-16 max-h-[calc(100dvh-4rem)] overflow-y-auto border-b border-hairline bg-canvas px-6 pt-4 pb-8"
      >
        <SearchBox locale={locale} />
        <nav aria-label={strings.countriesNav} class="mt-6">
          <h2 class="text-caption font-semibold tracking-wide text-mute uppercase">
            {strings.countriesNav}
          </h2>
          <ul class="mt-2 grid grid-cols-2 gap-1">
            {
              countries.map((c) => (
                <li>
                  <a
                    href={c.href}
                    class="focus-ring flex items-center gap-2 rounded-md px-2 py-2 text-body-sm font-semibold text-ink"
                  >
                    <Flag code={c.flagCode} class="h-[0.9em] w-auto shrink-0 rounded-[2px]" />
                    {c.adjective}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <nav aria-label={strings.sectionsNav} class="mt-6 border-t border-hairline pt-4">
          <ul class="grid gap-1">
            <li>
              <a
                href={browsePath(locale)}
                class="focus-ring block rounded-md px-2 py-2 text-body-sm font-semibold text-ink"
                >{strings.browse}</a
              >
            </li>
            <li>
              <button
                type="button"
                class="theme-toggle focus-ring flex items-center gap-2 rounded-md px-2 py-2 text-body-sm font-semibold text-ink"
                aria-pressed="false"
              >
                <svg
                  viewBox="0 0 24 24"
                  class="size-4 [[data-theme=dark]_&]:hidden"
                  data-icon="sun"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="12" cy="12" r="4"></circle>
                  <path
                    d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
                  ></path>
                </svg>
                <svg
                  viewBox="0 0 24 24"
                  class="hidden size-4 [[data-theme=dark]_&]:block"
                  data-icon="moon"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
              </button>
            </li>
          </ul>
        </nav>
        <div class="mt-6 border-t border-hairline pt-4">
          <LocaleSwitcher locale={locale} alternates={alternates} flat />
        </div>
      </div>
    </details>
  </div>

  <!-- Country strip. Country/region is the site's primary taxonomy, so it gets
       the persistent slot; topics live one level down, inside a country. -->
  <div class="hidden border-t border-hairline-soft md:block">
    <div class="container-site flex flex-wrap items-center justify-center gap-1.5 py-2">
      {
        countries.map((c) => (
          <a
            href={c.href}
            aria-current={isCurrent(c.href)}
            class="focus-ring rounded-full bg-surface-card px-3 py-1.5 text-body-sm text-charcoal aria-[current=page]:bg-ink aria-[current=page]:text-canvas hover:bg-surface-sunk"
          >
            {c.adjective}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    function isDark() {
      return document.documentElement.getAttribute('data-theme') === 'dark';
    }

    function updatePressed() {
      var pressed = isDark() ? 'true' : 'false';
      document.querySelectorAll('.theme-toggle').forEach(function (btn) {
        btn.setAttribute('aria-pressed', pressed);
      });
    }

    document.querySelectorAll('.theme-toggle').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var next = isDark() ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try {
          localStorage.setItem('theme', next);
        } catch (e) {}
        updatePressed();
      });
    });

    updatePressed();
  })();
</script>
