---
import type { Entry } from '../lib/urls';
import TermName from './TermName.astro';
import { PART_OF_SPEECH_LABEL, REGISTER_LABEL } from '../data/taxonomy';
import { DEFAULT_LOCALE, type Locale } from '../data/locales';
import { t } from '../i18n/ui';

interface Props {
  entry: Entry;
  href: string;
  /** BCP 47 tag for the term itself, e.g. es-MX. */
  lang: string;
  /** The first definition in the page's locale, not necessarily the entry's. */
  gloss: string;
  senseCount: number;
  locale?: Locale;
  /** Shown on cross-country surfaces (browse, search). */
  countryLabel?: string;
  flagEmoji?: string;
}

const {
  entry,
  href,
  lang,
  gloss,
  senseCount,
  locale = DEFAULT_LOCALE,
  countryLabel,
  flagEmoji,
} = Astro.props;
const { term, romanization, register, partOfSpeech, usageWarning, pronunciation } = entry.data;

const pos = partOfSpeech.map((p) => PART_OF_SPEECH_LABEL(locale, p)).join(', ');

const strings = t(locale);
const moreSenses = strings.moreSenses(senseCount - 1);
const careLabel = strings.useWithCare;
---

<article class="masonry-item">
  <a
    href={href}
    class="focus-ring block rounded-md bg-canvas p-5 ring-1 ring-hairline-soft transition-colors hover:bg-surface-card"
  >
    <div class="flex items-baseline gap-2">
      <TermName
        term={term}
        romanization={romanization}
        lang={lang}
        class="text-heading-lg text-ink"
      />
      {
        countryLabel && (
          <span class="ml-auto shrink-0 text-caption text-mute">
            <span aria-hidden="true">{flagEmoji}</span> {countryLabel}
          </span>
        )
      }
    </div>

    <p class="mt-1 text-caption text-mute">
      {pos} · {REGISTER_LABEL(locale, register)}
      {pronunciation?.respelling && <> · {pronunciation.respelling}</>}
    </p>

    <p class="mt-3 text-body-sm text-body">{gloss}</p>

    {senseCount > 1 && <p class="mt-2 text-caption text-ash">{moreSenses}</p>}

    {
      usageWarning.length > 0 && (
        <p class="mt-3 inline-flex rounded-full bg-warn-pale px-2.5 py-1 text-caption font-medium text-warn-deep">
          {careLabel}
        </p>
      )
    }
  </a>
</article>
