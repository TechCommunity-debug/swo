---
import { ALPHABET } from '../lib/urls';

interface Props {
  /** Letters that actually have entries. Others render disabled. */
  available: Set<string>;
  /** Prefix for the anchor ids, so two bars on one page don't collide. */
  idPrefix?: string;
}

const { available, idPrefix = 'letter' } = Astro.props;
const letters = available.has('#') ? [...ALPHABET, '#'] : ALPHABET;
---

<nav aria-label="Jump to letter" class="flex flex-wrap gap-1">
  {
    letters.map((letter) =>
      available.has(letter) ? (
        <a
          href={`#${idPrefix}-${letter === '#' ? 'other' : letter}`}
          class="focus-ring flex size-9 items-center justify-center rounded-full text-body-sm font-semibold text-ink hover:bg-surface-card"
        >
          {letter}
        </a>
      ) : (
        <span
          aria-hidden="true"
          class="flex size-9 items-center justify-center rounded-full text-body-sm text-stone"
        >
          {letter}
        </span>
      ),
    )
  }
</nav>
