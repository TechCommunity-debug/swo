---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import JsonLd from '../JsonLd.astro';
import TermName from '../TermName.astro';
import Flag from '../Flag.astro';
import { entrySeo } from '../../lib/seo';
import { absolute, breadcrumbs, definedTerm } from '../../lib/schema';
import { homePath } from '../../lib/urls';
import { needsGloss } from '../../lib/localize';
import { PART_OF_SPEECH_LABEL, REGISTER_LABEL, USAGE_WARNING_LABEL } from '../../data/taxonomy';
import { t } from '../../i18n/ui';
import { localeConfig } from '../../data/locales';
import type { EntryPageProps } from '../../lib/routes';

type Props = EntryPageProps;

const {
  locale,
  entry,
  country,
  category,
  content,
  categories,
  prev,
  next,
  related,
  moreInCategory,
  alsoUsedIn,
  countryHref,
  categoryHref,
  alternates,
} = Astro.props;

const d = entry.data;
const strings = t(locale);
const lang = country.languageCode;

// Whether the example sentences still need a gloss underneath. On the Spanish
// edition of a Mexican entry they do not: the sentence is already in the
// reader's language, and repeating it in English would be noise.
const gloss = needsGloss(lang, locale);

const seo = entrySeo(d, content.definitions[0].text, country, locale);
const path = Astro.url.pathname;

const dateLocale = localeConfig(locale).dateLocale;
const updated = d.updatedDate.toLocaleDateString(dateLocale, {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const schema = [
  definedTerm({
    term: d.term,
    romanization: d.romanization,
    description: content.definitions[0].text,
    path,
    termLanguage: lang,
    termSetId: `${absolute(countryHref)}#termset`,
    variants: d.variants,
  }),
  breadcrumbs([
    { name: strings.home, path: homePath(locale) },
    { name: strings.countrySlang(country.adjective), path: countryHref },
    { name: category.name, path: categoryHref },
    { name: d.term, path },
  ]),
];

const sidebarLink =
  'focus-ring group flex items-center justify-between gap-2 rounded-md px-3 py-2 text-body-md text-ink-soft hover:bg-surface-card hover:text-ink';
---

<Layout
  title={seo.title}
  description={seo.description}
  locale={locale}
  ogType="article"
  alternates={alternates}
>
  <JsonLd slot="head" schema={schema} />

  <div class="container-site py-8 lg:py-12">
    <Breadcrumbs
      locale={locale}
      items={[
        { label: strings.countrySlang(country.adjective), href: countryHref },
        { label: category.name, href: categoryHref },
        { label: d.term },
      ]}
    />

    <div class="mt-8 grid gap-12 lg:grid-cols-[minmax(0,1fr)_18rem]">
      <article>
        <header>
          <h1 class="text-display-lg text-ink" lang={d.romanization ? undefined : lang}>
            {
              d.romanization ? (
                <TermName term={d.term} romanization={d.romanization} lang={lang} />
              ) : (
                d.term
              )
            }
          </h1>

          <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-body-sm text-mute">
            {
              d.pronunciation?.respelling && (
                <span class="text-body-md text-charcoal">{d.pronunciation.respelling}</span>
              )
            }
            {d.pronunciation?.ipa && <span class="font-mono">{d.pronunciation.ipa}</span>}
            <span class="italic">
              {d.partOfSpeech.map((p) => PART_OF_SPEECH_LABEL(locale, p)).join(', ')}
            </span>
            <span
              class="rounded-full bg-surface-card px-2.5 py-1 text-caption font-medium text-charcoal not-italic"
              >{REGISTER_LABEL(locale, d.register)}</span
            >
            {
              d.region && d.region !== 'General' && (
                <span class="rounded-full bg-surface-card px-2.5 py-1 text-caption font-medium text-charcoal">
                  {d.region}
                </span>
              )
            }
          </p>

          <p class="mt-4 text-body-md text-mute">
            {strings.aSlangTerm(country.languageName)}{' '}
            <a href={countryHref} class="focus-ring rounded-sm font-semibold text-ink-soft hover:underline"
              >{strings.browseAll(country.adjective)}</a
            >.
          </p>
        </header>

        {
          d.usageWarning.length > 0 && (
            <aside
              class="mt-8 rounded-md bg-warn-pale p-5 text-warn-deep"
              aria-labelledby="usage-warning"
            >
              <h2 id="usage-warning" class="text-body-md font-bold">
                {strings.beforeYouUse}
              </h2>
              <ul class="mt-2 grid gap-1 text-body-sm">
                {d.usageWarning.map((w) => (
                  <li>{USAGE_WARNING_LABEL(locale, w)}</li>
                ))}
              </ul>
            </aside>
          )
        }

        <section class="mt-10" aria-labelledby="meaning">
          <h2 id="meaning" class="text-heading-xl text-ink">{strings.whatItMeans}</h2>
          <ol class="mt-4 grid gap-5">
            {
              content.definitions.map((def, i) => (
                <li class="grid grid-cols-[1.75rem_minmax(0,1fr)] gap-x-2">
                  <span class="pt-0.5 text-body-sm font-bold text-ash" aria-hidden="true">
                    {i + 1}.
                  </span>
                  <div>
                    <p class="text-body-md text-body">{def.text}</p>
                    {def.note && <p class="mt-1 text-body-sm text-mute">{def.note}</p>}
                  </div>
                </li>
              ))
            }
          </ol>

          {
            content.literalMeaning && (
              <p class="mt-5 rounded-md bg-surface-card p-4 text-body-sm text-charcoal">
                <span class="font-semibold text-ink">{strings.literally}</span>{' '}
                {content.literalMeaning}
              </p>
            )
          }
        </section>

        <section class="mt-10" aria-labelledby="examples">
          <h2 id="examples" class="text-heading-xl text-ink">
            {gloss ? strings.examplesWithTranslations : strings.inUse}
          </h2>
          <ul class="mt-4 grid gap-5">
            {
              content.examples.map((ex) => (
                <li class="border-l-2 border-hairline pl-4">
                  <p class="text-body-md text-ink" lang={lang}>
                    {ex.text}
                  </p>
                  {gloss && <p class="mt-1 text-body-sm text-mute">{ex.translation}</p>}
                  {ex.context && (
                    <p class="mt-2 text-body-sm text-charcoal">
                      <span class="font-semibold">{strings.note}</span> {ex.context}
                    </p>
                  )}
                </li>
              ))
            }
          </ul>
        </section>

        {
          content.origin && (
            <section class="mt-10" aria-labelledby="origin">
              <h2 id="origin" class="text-heading-xl text-ink">{strings.whereItComesFrom}</h2>
              <p class="mt-4 text-body-md text-body">{content.origin.etymology}</p>
              {content.origin.firstAttested && (
                <p class="mt-2 text-body-sm text-mute">
                  {strings.firstAttested(content.origin.firstAttested)}
                </p>
              )}
              {content.origin.sources.length > 0 && (
                <ul class="mt-3 grid gap-1 text-body-sm">
                  {content.origin.sources.map((s) => (
                    <li>
                      <a
                        href={s.url}
                        rel="noopener"
                        class="focus-ring rounded-sm text-ink-soft hover:underline"
                      >
                        {s.title}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          )
        }

        {
          (d.variants.length > 0 || d.synonyms.length > 0 || d.romanization) && (
            <section class="mt-10" aria-labelledby="forms">
              <h2 id="forms" class="text-heading-xl text-ink">{strings.otherForms}</h2>
              <dl class="mt-4 grid gap-3 text-body-md">
                {d.romanization && (
                  <div class="flex flex-wrap gap-x-2">
                    <dt class="font-semibold text-ink">{strings.romanizedAs}:</dt>
                    <dd class="text-body">{d.romanization}</dd>
                  </div>
                )}
                {d.variants.length > 0 && (
                  <div class="flex flex-wrap gap-x-2">
                    <dt class="font-semibold text-ink">{strings.spellingsAndVariants}</dt>
                    <dd class="text-body" lang={lang}>
                      {d.variants.join(', ')}
                    </dd>
                  </div>
                )}
                {d.synonyms.length > 0 && (
                  <div class="flex flex-wrap gap-x-2">
                    <dt class="font-semibold text-ink">{strings.similarTerms}</dt>
                    <dd class="text-body" lang={lang}>
                      {d.synonyms.join(', ')}
                    </dd>
                  </div>
                )}
              </dl>
            </section>
          )
        }

        <nav
          aria-label={strings.nearbyTerms}
          class="mt-12 flex items-stretch justify-between gap-4 border-t border-hairline pt-6"
        >
          {
            prev ? (
              <a
                href={prev.href}
                rel="prev"
                class="focus-ring group flex max-w-[45%] items-center gap-3 rounded-md p-2 text-left hover:bg-surface-card"
              >
                <span
                  aria-hidden="true"
                  class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-surface-sunk text-ink"
                >
                  <svg viewBox="0 0 20 20" fill="none" class="h-4 w-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 10H4M4 10L9 5M4 10L9 15" />
                  </svg>
                </span>
                <span>
                  <span class="block text-caption text-mute">{strings.previous}</span>
                  <TermName
                    term={prev.term}
                    romanization={prev.romanization}
                    lang={prev.lang}
                    class="text-body-md font-semibold text-ink group-hover:underline"
                  />
                </span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a
                href={next.href}
                rel="next"
                class="focus-ring group ml-auto flex max-w-[45%] items-center gap-3 rounded-md p-2 text-right hover:bg-surface-card"
              >
                <span>
                  <span class="block text-caption text-mute">{strings.next}</span>
                  <TermName
                    term={next.term}
                    romanization={next.romanization}
                    lang={next.lang}
                    class="text-body-md font-semibold text-ink group-hover:underline"
                  />
                </span>
                <span
                  aria-hidden="true"
                  class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-surface-sunk text-ink"
                >
                  <svg viewBox="0 0 20 20" fill="none" class="h-4 w-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 10H16M16 10L11 5M16 10L11 15" />
                  </svg>
                </span>
              </a>
            )
          }
        </nav>
      </article>

      <aside class="grid content-start gap-8 lg:sticky lg:top-32">
        {
          related.length > 0 && (
            <section
              aria-labelledby="related"
              class="rounded-lg border border-hairline bg-surface-card/60 p-4"
            >
              <h2 id="related" class="text-heading-md text-ink">{strings.relatedTerms}</h2>
              <ul class="mt-2 grid">
                {related.map((r) => (
                  <li>
                    <a href={r.href} class={sidebarLink}>
                      <TermName term={r.term} romanization={r.romanization} lang={r.lang} />
                      <svg
                        aria-hidden="true"
                        viewBox="0 0 20 20"
                        fill="none"
                        class="h-3.5 w-3.5 shrink-0 text-mute group-hover:text-ink"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M7 4L13 10L7 16" />
                      </svg>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          alsoUsedIn.length > 0 && (
            <section
              aria-labelledby="also-used"
              class="rounded-lg border border-hairline bg-surface-card/60 p-4"
            >
              <h2 id="also-used" class="text-heading-md text-ink">{strings.alsoUsedIn}</h2>
              <ul class="mt-2 grid">
                {alsoUsedIn.map((a) => (
                  <li>
                    <a href={a.href} class={sidebarLink}>
                      <span class="flex min-w-0 items-center">
                        <Flag code={a.flagCode} class="h-[0.9em] w-auto shrink-0 rounded-[2px]" />
                        <span class="ml-2 truncate">{strings.countrySlang(a.adjective)}</span>
                      </span>
                      <svg
                        aria-hidden="true"
                        viewBox="0 0 20 20"
                        fill="none"
                        class="h-3.5 w-3.5 shrink-0 text-mute group-hover:text-ink"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M7 4L13 10L7 16" />
                      </svg>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <section
          aria-labelledby="topics"
          class="rounded-lg border border-hairline bg-surface-card/60 p-4"
        >
          <h2 id="topics" class="text-heading-md text-ink">{strings.topics}</h2>
          <ul class="mt-3 flex flex-wrap gap-2">
            {
              categories.map((c) => (
                <li>
                  <a
                    href={c.href}
                    class="focus-ring inline-flex rounded-full bg-surface-page px-3 py-1.5 text-body-sm font-semibold text-ink ring-1 ring-inset ring-hairline hover:bg-surface-sunk"
                  >
                    {c.category.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        {
          moreInCategory.length > 0 && (
            <section
              aria-labelledby="more-in-category"
              class="rounded-lg border border-hairline bg-surface-card/60 p-4"
            >
              <h2 id="more-in-category" class="text-heading-md text-ink">
                {strings.moreTermsLikeThis(country.adjective)}
              </h2>
              <ul class="mt-2 grid">
                {moreInCategory.map((r) => (
                  <li>
                    <a href={r.href} class={sidebarLink}>
                      <TermName term={r.term} romanization={r.romanization} lang={r.lang} />
                      <svg
                        aria-hidden="true"
                        viewBox="0 0 20 20"
                        fill="none"
                        class="h-3.5 w-3.5 shrink-0 text-mute group-hover:text-ink"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M7 4L13 10L7 16" />
                      </svg>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <p class="text-caption text-mute">
          {strings.updatedOn(updated)}
        </p>
      </aside>
    </div>
  </div>
</Layout>
