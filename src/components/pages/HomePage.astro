---
import Layout from '../../layouts/Layout.astro';
import SearchBox from '../SearchBox.astro';
import EntryCard from '../EntryCard.astro';
import JsonLd from '../JsonLd.astro';
import TermName from '../TermName.astro';
import Flag from '../Flag.astro';
import {
  categoryPath,
  countryPath,
  entryUrl,
  homePath,
  searchPath,
  type Entry,
} from '../../lib/urls';
import {
  categoriesFor,
  countriesFor,
  entriesFor,
  homeAlternates,
  loadSite,
} from '../../lib/site';
import { localizeCountry, translatedEntry } from '../../lib/localize';
import { localizeCategory, regionGroupName, REGION_GROUPS } from '../../data/taxonomy';
import { homeSeo, SITE_NAME, SITE_TAGLINE, SITE_URL } from '../../lib/seo';
import { DEFAULT_LOCALE, localeConfig, type Locale } from '../../data/locales';
import { depth } from '../../lib/routes';
import { t } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const strings = t(locale);

const site = await loadSite();
const countries = countriesFor(site, locale);

const localized = countries.map((country) => {
  const entries = entriesFor(site, country.id, locale);
  return { country, entries, c: localizeCountry(country, locale) };
});

const totalTerms = localized.reduce((n, x) => n + x.entries.length, 0);

const grouped = REGION_GROUPS.map((group) => ({
  name: regionGroupName(group, locale),
  countries: localized.filter((x) => x.c.regionGroup === group.id),
})).filter((g) => g.countries.length > 0);

/**
 * The topic band: the biggest country × topic page for each country.
 *
 * These are the site's long-tail entry points, so the home page links to them
 * directly rather than to an abstract category index — there is no longer any
 * such index, because "slang for people" with no country attached is not a
 * page anyone was looking for.
 */
const topics = localized
  .flatMap(({ c, entries }) =>
    categoriesFor(entries)
      .sort((a, b) => b.count - a.count)
      .slice(0, 1)
      .map(({ category, count }) => {
        const cat = localizeCategory(category, locale);
        return {
          href: categoryPath(c.urlSlug, cat.urlSlug, locale),
          label: strings.slangFor(c.adjective, cat.topic),
          description: cat.description,
          count,
          flagCode: c.flagCode,
        };
      }),
  )
  .slice(0, 6);

// One term per country, picked for editorial depth rather than shuffled, so the
// home page shows the site at its best and stays stable between builds.
const featured = localized
  .map(({ c, entries }) => {
    const best = [...entries].sort((a, b) => depth(b) - depth(a))[0];
    return best ? { entry: best, c } : null;
  })
  .filter((x): x is { entry: Entry; c: (typeof localized)[number]['c'] } => Boolean(x));

const examples = featured.slice(0, 3);

const seo = homeSeo(
  locale,
  localized.map((x) => x.c.adjective),
);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE_URL}/#website`,
    name: SITE_NAME,
    alternateName: SITE_TAGLINE[locale],
    url: new URL(homePath(locale), SITE_URL).href,
    inLanguage: localeConfig(locale).hreflang,
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${new URL(searchPath(locale), SITE_URL).href}?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${SITE_URL}/#organization`,
    name: SITE_NAME,
    url: `${SITE_URL}/`,
  },
];


// FAQ data — visible section + JSON-LD FAQPage structured data
const faqItems = [
  {
    question: 'What are slang words?',
    answer: 'Slang words are informal words or phrases that are more common in spoken language than in writing. They often originate within specific social groups, subcultures, or regions and may carry meanings that differ from their standard dictionary definitions. Slang can express identity, humor, or attitude and tends to evolve much faster than formal vocabulary — words that were edgy a decade ago can feel dated today.',
  },
  {
    question: 'What is the newest slang?',
    answer: 'Slang evolves constantly, with new terms emerging from social media platforms like TikTok, Twitter/X, and Instagram every week. Some recent examples include “delulu” (delusionally optimistic), “rizz” (charisma, especially in flirting), “slay” (to do something exceptionally well), and “ate” (nailed it, did an amazing job). The fastest way to stay current is to follow trending conversations online — or browse our regularly updated collection by country.',
  },
  {
    question: 'How does slang differ from formal language?',
    answer: 'Formal language follows standard grammar and vocabulary rules and is used in professional, academic, or official settings. Slang, by contrast, is casual, often breaks grammatical conventions, and is tied to specific communities or generations. A word like “cool” is understood everywhere, but slang terms like “chuffed” (British for pleased) or “naco” (Mexican for tacky) only make full sense when you know the culture behind them.',
  },
  {
    question: 'Why do different countries have different slang?',
    answer: 'Slang is shaped by local culture, history, and social dynamics. Even countries that share the same language — like the US, UK, and Australia for English, or Mexico, Spain, and Colombia for Spanish — develop completely different slang vocabularies. This happens because slang reflects lived experience: local food, music, humor, class structures, and media all leave their fingerprints on informal speech.',
  },
  {
    question: 'Is it okay to use slang in everyday conversation?',
    answer: 'Absolutely — slang is a natural part of how people communicate, and using it appropriately shows social awareness and fluency. The key is context: slang fits perfectly in casual conversation, texting, and social media, but may be out of place in a job interview, academic paper, or formal email. Knowing when to switch registers is itself a language skill.',
  },
  {
    question: 'How can I learn slang from other countries?',
    answer: 'Immersion is the best teacher — watching local TV shows, following social media creators from that country, and talking with native speakers all help. A curated resource like Slang Words Online also gives you the context dictionaries miss: who uses the word, whether it is friendly or offensive, and how it actually sounds in a sentence. We cover sixteen countries and thousands of terms, each with definitions, pronunciation guides, and real-world examples.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

const SEO_KEYWORDS = [
  'slang words', 'British Slang', 'American Slang', 'Australian Slang',
  'Canadian Slang', 'Mexican Slang', 'Spanish Slang', 'Italian Slang',
  'French Slang', 'Japanese Slang', 'Korean Slang', 'Colombian Slang',
  'Cuban Slang', 'Dominican Slang', 'Irish Slang', 'German Slang',
  'Russian Slang', 'Slang for Approval & Praise', 'Slang for Greetings & Address',
  'Slang for Insults & Complaints', 'Slang for People', 'Slang for Money & Work',
  'Slang for Food & Drink', 'Slang for Going Out & Partying',
  'Slang for Romance & Flirting', 'Slang for Emotion & Reaction',
  'Slang for Filler Words', 'Slang for Everyday Things',
  'slang words hub', 'slang words library',
].join(', ');
---

<Layout
  title={seo.title}
  description={seo.description}
  locale={locale}
  alternates={homeAlternates()}
  keywords={SEO_KEYWORDS}
>
  <JsonLd slot="head" schema={[...schema, faqSchema]} />

  <section class="border-b border-hairline-soft bg-canvas">
    <div class="container-site py-16 lg:py-24">
      <div class="max-w-3xl">
        <h1 class="text-display-lg text-ink sm:text-display-xl">{strings.homeH1}</h1>
        <p class="mt-5 max-w-2xl text-body-md text-mute sm:text-heading-md sm:font-normal">
          {strings.homeLead(totalTerms, countries.length)}
        </p>
        <div class="mt-8 max-w-2xl">
          <SearchBox locale={locale} />
        </div>
        {
          examples.length > 0 && (
            <p class="mt-3 text-body-sm text-mute">
              {strings.tryTerms}{' '}
              {examples.map((x, i) => (
                <>
                  {i > 0 && ', '}
                  <a
                    href={entryUrl(x.entry, site.byId, locale)}
                    class="focus-ring rounded-sm font-semibold text-ink-soft hover:underline"
                  >
                    <TermName
                      term={x.entry.data.term}
                      romanization={x.entry.data.romanization}
                      lang={x.c.languageCode}
                    />
                  </a>
                </>
              ))}
              .
            </p>
          )
        }
      </div>
    </div>
  </section>

  <div class="container-site py-section">
    <section aria-labelledby="countries">
      <h2 id="countries" class="text-heading-xl text-ink">{strings.pickCountry}</h2>
      <p class="mt-2 max-w-2xl text-body-md text-mute">{strings.pickCountryLead}</p>
      <div class="mt-8 grid gap-10">
        {
          grouped.map((group) => (
            <div>
              <h3 class="text-caption font-semibold tracking-wide text-mute uppercase">
                {group.name}
              </h3>
              <ul class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
                {group.countries.map(({ country, c, entries }) => (
                  <li>
                    <a
                      href={countryPath(country, locale)}
                      class="focus-ring flex h-full flex-col gap-1 rounded-md bg-canvas p-5 ring-1 ring-hairline-soft hover:bg-surface-card"
                    >
                      <span class="flex items-center gap-2">
                        <Flag code={c.flagCode} class="h-4 w-auto shrink-0 rounded-[2px]" />
                        <span class="text-heading-md text-ink">
                          {strings.countrySlang(c.adjective)}
                        </span>
                      </span>
                      <span class="text-body-sm text-mute">
                        {strings.termsCount(entries.length)} · {c.languageName}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-section" aria-labelledby="topics">
      <div class="max-w-2xl">
        <h2 id="topics" class="text-heading-xl text-ink">{strings.popularTopics}</h2>
        <p class="mt-2 text-body-md text-mute">{strings.popularTopicsLead}</p>
      </div>
      <ul class="mt-8 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {
          topics.map((topic) => (
            <li>
              <a
                href={topic.href}
                class="focus-ring relative flex h-full flex-col rounded-md bg-surface-card p-5 hover:bg-surface-sunk"
              >
                <span class="flex items-center gap-1.5 text-heading-md text-ink">
                  <Flag code={topic.flagCode} class="h-[0.9em] w-auto shrink-0 rounded-[2px]" />
                  {topic.label}
                </span>
                <span class="mt-1 text-caption text-mute">{strings.termsCount(topic.count)}</span>
                <span class="mt-3 line-clamp-3 text-body-sm text-charcoal">
                  {topic.description}
                </span>
                <span
                  aria-hidden="true"
                  class="absolute right-3 top-3 flex h-8 w-8 items-center justify-center rounded-full bg-canvas text-ink"
                >
                  <svg viewBox="0 0 20 20" fill="none" class="h-4 w-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 10H16M16 10L11 5M16 10L11 15" />
                  </svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-section" aria-labelledby="featured">
      <h2 id="featured" class="text-heading-xl text-ink">{strings.oneWordEach}</h2>
      <p class="mt-2 max-w-2xl text-body-md text-mute">{strings.oneWordEachLead}</p>
      <div class="masonry mt-8">
        {
          featured.map(({ entry, c }) => {
            const content = translatedEntry(entry, locale)!;
            return (
              <EntryCard
                entry={entry}
                href={entryUrl(entry, site.byId, locale)}
                lang={c.languageCode}
                gloss={content.definitions[0].text}
                senseCount={content.definitions.length}
                locale={locale}
                countryLabel={c.adjective}
                flagCode={c.flagCode}
              />
            );
          })
        }
      </div>
    </section>

    <section
      class="mt-section grid gap-6 rounded-lg bg-canvas p-8 ring-1 ring-hairline-soft lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] lg:items-center lg:p-12"
      aria-labelledby="editorial"
    >
      <div>
        <h2 id="editorial" class="text-heading-xl text-ink">{strings.editorialH2}</h2>
        <p class="mt-4 text-body-md text-body">{strings.editorialBody}</p>
      </div>
    </section>

    <section class="mt-section" aria-labelledby="faq">
      <div class="max-w-3xl">
        <h2 id="faq" class="text-heading-xl text-ink">{strings.faqH2}</h2>
        <dl class="mt-8 divide-y divide-hairline-soft">
          {
            faqItems.map((item) => (
              <details class="group py-5 first:pt-0 last:pb-0">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-heading-md text-ink hover:text-primary [&::-webkit-details-marker]:hidden">
                  <span>{item.question}</span>
                  <span
                    aria-hidden="true"
                    class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-surface-card text-mute transition-transform group-open:rotate-45"
                  >
                    <svg viewBox="0 0 16 16" fill="none" class="h-4 w-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
                      <path d="M8 3v10M3 8h10" />
                    </svg>
                  </span>
                </summary>
                <p class="mt-3 text-body-md text-body leading-relaxed">{item.answer}</p>
              </details>
            ))
          }
        </dl>
      </div>
    </section>

    <section
      class="mt-section"
      aria-labelledby="about"
    >
      <div class="max-w-3xl">
        <h2 id="about" class="text-heading-xl text-ink">{strings.aboutH2}</h2>
        <div class="mt-6 space-y-5 text-body-md text-body leading-relaxed">
          <p>{strings.aboutP1}</p>
          <p>{strings.aboutP2}</p>
          <p>{strings.aboutP3}</p>
          <p>{strings.aboutP4}</p>
          <p>{strings.aboutP5}</p>
        </div>
      </div>
    </section>
  </div>
</Layout>
