---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import JsonLd from '../JsonLd.astro';
import { homePath } from '../../lib/urls';
import { privacyAlternates } from '../../lib/site';
import { breadcrumbs } from '../../lib/schema';
import { DEFAULT_LOCALE, type Locale } from '../../data/locales';
import { t } from '../../i18n/ui';
import { SITE_NAME } from '../../lib/seo';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const strings = t(locale);

const CONTACT_EMAIL = 'techcommunity611@gmail.com';

const pageTitle = `${strings.privacyPolicy} | ${SITE_NAME}`;
const pageDescription =
  'Read the Privacy Policy for Slang Words Online. Learn how we handle data, cookies, and visitor privacy across our global slang dictionary.';

const schema = breadcrumbs([
  { name: strings.home, path: homePath(locale) },
  { name: strings.privacyPolicy, path: Astro.url.pathname },
]);
---

<Layout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
  alternates={privacyAlternates()}
>
  <JsonLd slot="head" schema={schema} />

  <div class="container-site py-8 lg:py-12">
    <Breadcrumbs locale={locale} items={[{ label: strings.privacyPolicy }]} />

    <header class="mt-8 max-w-3xl">
      <span class="inline-block rounded-full bg-surface-card px-3 py-1 text-caption font-semibold uppercase tracking-wider text-mute">
        Legal &amp; Privacy
      </span>
      <h1 class="mt-3 text-display-lg text-ink">{strings.privacyPolicy}</h1>
      <p class="mt-3 text-body-sm text-mute">
        Last Updated: September 2026
      </p>
      <p class="mt-4 text-body-md text-body leading-relaxed">
        At Slang Words Online (<a href="/" class="text-primary hover:underline">slangwordsonline.com</a>), your privacy is straightforward. We believe an educational language resource should be transparent, safe, and respectful of everyone who explores it.
      </p>
    </header>

    <article class="mt-10 max-w-3xl space-y-10 text-body text-body-md leading-relaxed">
      <!-- 1. Key Privacy Principles -->
      <section>
        <h2 class="text-heading-xl text-ink">Our Privacy Principles</h2>
        <div class="mt-4 space-y-3">
          <div class="rounded-md border border-hairline bg-canvas p-4">
            <h3 class="text-heading-md font-semibold text-ink">1. No Account Required &amp; Free Access</h3>
            <p class="mt-1 text-body-sm text-body">
              You can freely browse all slang entries, explore countries, and search the dictionary without creating an account or providing personal details.
            </p>
          </div>

          <div class="rounded-md border border-hairline bg-canvas p-4">
            <h3 class="text-heading-md font-semibold text-ink">2. We Never Sell Your Data</h3>
            <p class="mt-1 text-body-sm text-body">
              We never monetize, broker, or sell personal visitor data to third parties, data brokers, or advertising networks.
            </p>
          </div>

          <div class="rounded-md border border-hairline bg-canvas p-4">
            <h3 class="text-heading-md font-semibold text-ink">3. Direct &amp; Transparent Communication</h3>
            <p class="mt-1 text-body-sm text-body">
              If you reach out to us at <a href={`mailto:${CONTACT_EMAIL}`} class="text-primary font-semibold hover:underline">{CONTACT_EMAIL}</a>, your email is used solely to answer your questions or review term suggestions.
            </p>
          </div>
        </div>
      </section>

      <!-- 2. Information We Collect -->
      <section>
        <h2 class="text-heading-xl text-ink">Information We Collect</h2>
        <p class="mt-3">
          We collect only the bare minimum information required to deliver, secure, and maintain the website:
        </p>
        <div class="mt-4 space-y-4">
          <div class="rounded-md border border-hairline bg-canvas p-4">
            <h3 class="text-heading-md text-ink">A. Anonymous Technical &amp; Log Data</h3>
            <p class="mt-1 text-body-sm text-body">
              When you visit our site, our hosting infrastructure automatically records non-identifying technical diagnostic logs (such as request timestamps, browser user agent, operating system, requested page URLs, and anonymized IP addresses). This data is strictly used for server performance monitoring, debugging, and blocking malicious scraping.
            </p>
          </div>

          <div class="rounded-md border border-hairline bg-canvas p-4">
            <h3 class="text-heading-md text-ink">B. Client-Side Preferences</h3>
            <p class="mt-1 text-body-sm text-body">
              When you toggle between light and dark theme, your selection is stored locally in your browser&apos;s <code>localStorage</code>. This data remains on your personal device and is never transmitted to our servers.
            </p>
          </div>

          <div class="rounded-md border border-hairline bg-canvas p-4">
            <h3 class="text-heading-md text-ink">C. Direct Email Correspondence</h3>
            <p class="mt-1 text-body-sm text-body">
              If you email our team at <a href={`mailto:${CONTACT_EMAIL}`} class="text-primary font-semibold hover:underline">{CONTACT_EMAIL}</a>, we receive your email address, name (if provided), and message details. We retain this communication only as long as needed to address your feedback or update our dictionary.
            </p>
          </div>
        </div>
      </section>

      <!-- 3. Cookies and Tracking Technologies -->
      <section>
        <h2 class="text-heading-xl text-ink">Cookies and Tracking Technologies</h2>
        <p class="mt-3">
          Slang Words Online is designed with a strict privacy-first architecture:
        </p>
        <ul class="mt-3 list-disc pl-6 space-y-2 text-body-sm text-body">
          <li><strong>No Advertising or Tracking Cookies:</strong> We do not use third-party tracking cookies, behavioral tracking pixels, or cross-site tracking tools.</li>
          <li><strong>No Fingerprinting or Profiling:</strong> We do not profile your browsing habits across other websites or attempt to identify individual visitors.</li>
          <li><strong>Functional Local Storage:</strong> We use minimal client-side browser storage solely to preserve your visual theme preference (light or dark mode) so the site remains comfortable to read.</li>
        </ul>
      </section>

      <!-- 4. Policy Updates -->
      <section>
        <h2 class="text-heading-lg text-ink">Policy Updates</h2>
        <p class="mt-2 text-body-sm text-body">
          We may revise this Privacy Policy periodically to reflect minor website improvements or operational changes. Any updates will always be published directly on this page with an updated &ldquo;Last Updated&rdquo; date.
        </p>
      </section>

      <!-- 5. Contact Us -->
      <section class="rounded-md border border-hairline bg-surface-card p-6">
        <h2 class="text-heading-lg text-ink">Contact Us</h2>
        <p class="mt-2 text-body-sm text-body">
          If you have any questions, feedback, or concerns regarding our privacy practices, please contact our team directly:
        </p>
        <div class="mt-4 flex flex-col gap-2 sm:flex-row sm:items-center">
          <span class="font-semibold text-ink">Email:</span>
          <a
            href={`mailto:${CONTACT_EMAIL}`}
            class="text-primary font-semibold hover:underline"
          >
            {CONTACT_EMAIL}
          </a>
        </div>
      </section>
    </article>
  </div>
</Layout>
