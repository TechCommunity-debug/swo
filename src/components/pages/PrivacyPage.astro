---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import JsonLd from '../JsonLd.astro';
import { homePath } from '../../lib/urls';
import { privacyAlternates } from '../../lib/site';
import { breadcrumbs } from '../../lib/schema';
import { DEFAULT_LOCALE, type Locale } from '../../data/locales';
import { t } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const strings = t(locale);

const CONTACT_EMAIL = 'techcommunity611@gmail.com';

const pageTitle = `${strings.privacyPolicy} ? Slang Words Online`;
const pageDescription =
  'Read the Privacy Policy for Slang Words Online. Learn how we handle data and respect visitor privacy across our global slang dictionary.';

const schema = breadcrumbs([
  { name: strings.home, path: homePath(locale) },
  { name: strings.privacyPolicy, path: Astro.url.pathname },
]);
---

<Layout
  title={pageTitle}
  description={pageDescription}
  locale={locale}
  alternates={privacyAlternates()}
>
  <JsonLd slot="head" schema={schema} />

  <div class="container-site py-8 lg:py-12">
    <Breadcrumbs locale={locale} items={[{ label: strings.privacyPolicy }]} />

    <header class="mt-8 max-w-3xl">
      <span class="inline-block rounded-full bg-surface-card px-3 py-1 text-caption font-semibold uppercase tracking-wider text-mute">
        Legal &amp; Privacy
      </span>
      <h1 class="mt-3 text-display-lg text-ink">{strings.privacyPolicy}</h1>
      <p class="mt-3 text-body-sm text-mute">
        Effective Date: September 2026 ? Last Updated: September 2026
      </p>
      <p class="mt-4 text-body-md text-body leading-relaxed">
        At Slang Words Online (<a href="/" class="text-primary hover:underline">slangwordsonline.com</a>), your privacy is straightforward. We believe an educational language resource should be transparent, safe, and respectful of everyone who explores it.
      </p>
    </header>

    <!-- Key Privacy Principles -->
    <article class="mt-10 max-w-3xl space-y-8 text-body text-body-md leading-relaxed">
      <section>
        <h2 class="text-heading-xl text-ink">Our Privacy Principles</h2>
        <div class="mt-5 space-y-4">
          <div class="rounded-md border border-hairline bg-canvas p-5">
            <h3 class="text-heading-md font-semibold text-ink">1. No Account Required &amp; No User Tracking</h3>
            <p class="mt-2 text-body-sm text-body">
              You can freely browse all slang entries, explore countries, and search the dictionary without creating an account or providing personal details. We do not use tracking cookies or sell your data. Settings such as light or dark mode are saved strictly on your own device in your browser&apos;s local storage.
            </p>
          </div>

          <div class="rounded-md border border-hairline bg-canvas p-5">
            <h3 class="text-heading-md font-semibold text-ink">2. Direct Email Inquiries Only</h3>
            <p class="mt-2 text-body-sm text-body">
              If you reach out to us at <a href={`mailto:${CONTACT_EMAIL}`} class="text-primary font-semibold hover:underline">{CONTACT_EMAIL}</a>, we only use your email address and message contents to answer your questions, review term suggestions, or resolve issues. We do not add you to marketing lists.
            </p>
          </div>

          <div class="rounded-md border border-hairline bg-canvas p-5">
            <h3 class="text-heading-md font-semibold text-ink">3. Performance &amp; Site Reliability</h3>
            <p class="mt-2 text-body-sm text-body">
              We monitor standard, anonymous server logs and performance metrics to keep the site fast, secure, and reliable for readers worldwide.
            </p>
          </div>
        </div>
      </section>

      <section>
        <h2 class="text-heading-lg text-ink">Policy Updates</h2>
        <p class="mt-2 text-body-sm text-body">
          We may revise this Privacy Policy from time to time to reflect minor updates or changes to the website. Any updates will always be published directly to this page.
        </p>
      </section>

      <section class="rounded-md border border-hairline bg-surface-card p-6">
        <h2 class="text-heading-lg text-ink">Contact Us</h2>
        <p class="mt-2 text-body-sm text-body">
          If you have any questions or feedback regarding our privacy practices, please contact us directly:
        </p>
        <div class="mt-4 flex flex-col gap-2 sm:flex-row sm:items-center">
          <span class="font-semibold text-ink">Email:</span>
          <a
            href={`mailto:${CONTACT_EMAIL}`}
            class="text-primary font-semibold hover:underline"
          >
            {CONTACT_EMAIL}
          </a>
        </div>
      </section>
    </article>
  </div>
</Layout>
