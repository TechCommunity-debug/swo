---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import JsonLd from '../JsonLd.astro';
import HeroLegalLinks from '../HeroLegalLinks.astro';
import { homePath } from '../../lib/urls';
import { privacyAlternates } from '../../lib/site';
import { breadcrumbs } from '../../lib/schema';
import { DEFAULT_LOCALE, type Locale } from '../../data/locales';
import { t } from '../../i18n/ui';
import { privacySeo } from '../../lib/seo';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const strings = t(locale);

const CONTACT_EMAIL = 'techcommunity611@gmail.com';

const seo = privacySeo(locale);

const schema = breadcrumbs([
  { name: strings.home, path: homePath(locale) },
  { name: strings.privacyPolicy, path: Astro.url.pathname },
]);
---

<Layout
  title={seo.title}
  description={seo.description}
  locale={locale}
  alternates={privacyAlternates()}
>
  <JsonLd slot="head" schema={schema} />

  <div class="container-site py-8 lg:py-12">
    <Breadcrumbs locale={locale} items={[{ label: strings.privacyPolicy }]} />

    <header class="mt-8 max-w-3xl">
      <span class="inline-block rounded-full bg-surface-card px-3 py-1 text-caption font-semibold uppercase tracking-wider text-mute">
        {strings.privacyKicker}
      </span>
      <h1 class="mt-3 text-display-lg text-ink">{strings.privacyPolicy}</h1>
      <p class="mt-3 text-body-sm text-mute">
        {strings.privacyLastUpdated}
      </p>
      <p class="mt-4 text-body-md text-body leading-relaxed" set:html={strings.privacyIntro} />
    </header>

    <article class="mt-10 max-w-3xl space-y-10 text-body text-body-md leading-relaxed">
      <!-- 1. Key Privacy Principles -->
      <section>
        <h2 class="text-heading-xl text-ink">{strings.privacyPrinciplesHeading}</h2>
        <div class="mt-4 space-y-3">
          <div class="rounded-md border border-hairline bg-canvas p-4">
            <h3 class="text-heading-md font-semibold text-ink">{strings.privacyPrinciple1Title}</h3>
            <p class="mt-1 text-body-sm text-body">
              {strings.privacyPrinciple1Body}
            </p>
          </div>

          <div class="rounded-md border border-hairline bg-canvas p-4">
            <h3 class="text-heading-md font-semibold text-ink">{strings.privacyPrinciple2Title}</h3>
            <p class="mt-1 text-body-sm text-body">
              {strings.privacyPrinciple2Body}
            </p>
          </div>

          <div class="rounded-md border border-hairline bg-canvas p-4">
            <h3 class="text-heading-md font-semibold text-ink">{strings.privacyPrinciple3Title}</h3>
            <p class="mt-1 text-body-sm text-body">
              {strings.privacyPrinciple3Body}
            </p>
          </div>
        </div>
      </section>

      <!-- 2. Information We Collect -->
      <section>
        <h2 class="text-heading-xl text-ink">{strings.privacyCollectHeading}</h2>
        <p class="mt-3">
          {strings.privacyCollectLead}
        </p>
        <div class="mt-4 space-y-4">
          <div class="rounded-md border border-hairline bg-canvas p-4">
            <h3 class="text-heading-md text-ink">{strings.privacyCollectA_Title}</h3>
            <p class="mt-1 text-body-sm text-body">
              {strings.privacyCollectA_Body}
            </p>
          </div>

          <div class="rounded-md border border-hairline bg-canvas p-4">
            <h3 class="text-heading-md text-ink">{strings.privacyCollectB_Title}</h3>
            <p class="mt-1 text-body-sm text-body" set:html={strings.privacyCollectB_Body} />
          </div>

          <div class="rounded-md border border-hairline bg-canvas p-4">
            <h3 class="text-heading-md text-ink">{strings.privacyCollectC_Title}</h3>
            <p class="mt-1 text-body-sm text-body">
              {strings.privacyCollectC_Body}
            </p>
          </div>
        </div>
      </section>

      <!-- 3. Cookies and Tracking Technologies -->
      <section>
        <h2 class="text-heading-xl text-ink">{strings.privacyCookiesHeading}</h2>
        <p class="mt-3">
          {strings.privacyCookiesLead}
        </p>
        <ul class="mt-3 list-disc pl-6 space-y-2 text-body-sm text-body">
          <li set:html={strings.privacyCookiesB1} />
          <li set:html={strings.privacyCookiesB2} />
          <li set:html={strings.privacyCookiesB3} />
        </ul>
      </section>

      <!-- 4. Policy Updates -->
      <section>
        <h2 class="text-heading-lg text-ink">{strings.privacyUpdatesHeading}</h2>
        <p class="mt-2 text-body-sm text-body">
          {strings.privacyUpdatesBody}
        </p>
      </section>

      <!-- 5. Contact Us -->
      <section class="rounded-md border border-hairline bg-surface-card p-6">
        <h2 class="text-heading-lg text-ink">{strings.contactUs}</h2>
        <p class="mt-2 text-body-sm text-body">
          {strings.privacyContactBody}
        </p>
        <div class="mt-4 flex flex-col gap-2 sm:flex-row sm:items-center">
          <span class="font-semibold text-ink">{strings.privacyContactEmailLabel}</span>
          <a
            href={`mailto:${CONTACT_EMAIL}`}
            class="text-primary font-semibold hover:underline"
          >
            {CONTACT_EMAIL}
          </a>
        </div>
      </section>

      <HeroLegalLinks locale={locale} class="mt-6" />
    </article>
  </div>
</Layout>
