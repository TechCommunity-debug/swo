---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import JsonLd from '../JsonLd.astro';
import HeroLegalLinks from '../HeroLegalLinks.astro';
import { homePath } from '../../lib/urls';
import { termsAlternates } from '../../lib/site';
import { breadcrumbs } from '../../lib/schema';
import { DEFAULT_LOCALE, type Locale } from '../../data/locales';
import { t } from '../../i18n/ui';
import { termsSeo } from '../../lib/seo';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const strings = t(locale);

const CONTACT_EMAIL = 'techcommunity611@gmail.com';

const seo = termsSeo(locale);

const schema = breadcrumbs([
  { name: strings.home, path: homePath(locale) },
  { name: strings.termsConditions, path: Astro.url.pathname },
]);
---

<Layout
  title={seo.title}
  description={seo.description}
  locale={locale}
  alternates={termsAlternates()}
>
  <JsonLd slot="head" schema={schema} />

  <div class="container-site py-8 lg:py-12">
    <Breadcrumbs locale={locale} items={[{ label: strings.termsConditions }]} />

    <header class="mt-8 max-w-3xl">
      <span class="inline-block rounded-full bg-surface-card px-3 py-1 text-caption font-semibold uppercase tracking-wider text-mute">
        {strings.termsKicker}
      </span>
      <h1 class="mt-3 text-display-lg text-ink">{strings.termsConditions}</h1>
      <p class="mt-3 text-body-sm text-mute">
        {strings.termsLastUpdated}
      </p>
      <p class="mt-4 text-body-md text-body leading-relaxed" set:html={strings.termsIntro} />
    </header>

    <!-- Key Principles Banner -->
    <div class="mt-8 max-w-3xl rounded-md border border-hairline bg-surface-card p-6">
      <h2 class="text-heading-md font-semibold text-ink">{strings.termsSummaryHeading}</h2>
      <ul class="mt-3 space-y-2 text-body-sm text-body">
        <li class="flex items-start gap-2">
          <span class="text-primary font-bold">1.</span>
          <span><strong>{strings.termsSummaryP1Title}</strong> {strings.termsSummaryP1Body}</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-primary font-bold">2.</span>
          <span><strong>{strings.termsSummaryP2Title}</strong> {strings.termsSummaryP2Body}</span>
        </li>
        <li class="flex items-start gap-2">
          <span class="text-primary font-bold">3.</span>
          <span><strong>{strings.termsSummaryP3Title}</strong> {strings.termsSummaryP3Body}</span>
        </li>
      </ul>
    </div>

    <!-- Main Content -->
    <article class="mt-10 max-w-3xl space-y-8 text-body text-body-md leading-relaxed">
      <section>
        <h2 class="text-heading-xl text-ink">{strings.termsSection1Heading}</h2>
        <p class="mt-3">
          {strings.termsSection1Body}
        </p>
      </section>

      <section>
        <h2 class="text-heading-xl text-ink">{strings.termsSection2Heading}</h2>
        <p class="mt-3">
          {strings.termsSection2Lead}
        </p>
        <ul class="mt-2 list-disc pl-6 space-y-1 text-body">
          <li>{strings.termsSection2B1}</li>
          <li>{strings.termsSection2B2}</li>
          <li>{strings.termsSection2B3}</li>
          <li>{strings.termsSection2B4}</li>
        </ul>
        <p class="mt-3">
          <strong>{strings.termsEditorialStanceLabel}</strong> {strings.termsEditorialStanceBody}
        </p>
      </section>

      <section>
        <h2 class="text-heading-xl text-ink">{strings.termsSection3Heading}</h2>
        <p class="mt-3">
          {strings.termsSection3Body}
        </p>
        <p class="mt-2">
          <strong>{strings.termsPermittedUseLabel}</strong> <span set:html={strings.termsPermittedUseBody} />
        </p>
        <p class="mt-2">
          <strong>{strings.termsProhibitedReproLabel}</strong> {strings.termsProhibitedReproBody}
        </p>
      </section>

      <section>
        <h2 class="text-heading-xl text-ink">{strings.termsSection4Heading}</h2>
        <p class="mt-3">{strings.termsSection4Lead}</p>
        <ul class="mt-2 list-disc pl-6 space-y-1 text-body">
          <li>{strings.termsSection4B1}</li>
          <li>{strings.termsSection4B2}</li>
          <li>{strings.termsSection4B3}</li>
          <li>{strings.termsSection4B4}</li>
        </ul>
      </section>

      <section>
        <h2 class="text-heading-xl text-ink">{strings.termsSection5Heading}</h2>
        <p class="mt-3">
          {strings.termsSection5Body}
        </p>
      </section>

      <section>
        <h2 class="text-heading-xl text-ink">{strings.termsSection6Heading}</h2>
        <p class="mt-3" set:html={strings.termsSection6Body1} />
        <p class="mt-2">
          {strings.termsSection6Body2}
        </p>
      </section>

      <section>
        <h2 class="text-heading-xl text-ink">{strings.termsSection7Heading}</h2>
        <p class="mt-3">
          {strings.termsSection7Body}
        </p>
      </section>

      <section>
        <h2 class="text-heading-xl text-ink">{strings.termsSection8Heading}</h2>
        <p class="mt-3">
          {strings.termsSection8Body}
        </p>
      </section>

      <section class="rounded-md border border-hairline bg-surface-card p-6">
        <h2 class="text-heading-xl text-ink">{strings.termsSection9Heading}</h2>
        <p class="mt-2 text-body">
          {strings.termsSection9Body}
        </p>
        <div class="mt-4 flex flex-col gap-2 sm:flex-row sm:items-center">
          <span class="font-semibold text-ink">{strings.termsContactEmailLabel}</span>
          <a
            href={`mailto:${CONTACT_EMAIL}`}
            class="text-primary font-semibold hover:underline"
          >
            {CONTACT_EMAIL}
          </a>
        </div>
      </section>

      <HeroLegalLinks locale={locale} class="mt-6" />
    </article>
  </div>
</Layout>
