---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import Flag from '../Flag.astro';
import JsonLd from '../JsonLd.astro';
import HeroLegalLinks from '../HeroLegalLinks.astro';
import { browsePath, countryPath, homePath, contactPath } from '../../lib/urls';
import { aboutAlternates, countriesFor, entriesFor, loadSite } from '../../lib/site';
import { localizeCountry } from '../../lib/localize';
import { breadcrumbs } from '../../lib/schema';
import { DEFAULT_LOCALE, type Locale } from '../../data/locales';
import { t } from '../../i18n/ui';
import { aboutSeo } from '../../lib/seo';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const strings = t(locale);

const site = await loadSite();
const countries = countriesFor(site, locale);
const totalEntries = countries.reduce(
  (acc, c) => acc + entriesFor(site, c.id, locale).length,
  0
);

const seo = aboutSeo(locale, countries.length, 9);

const schema = breadcrumbs([
  { name: strings.home, path: homePath(locale) },
  { name: strings.aboutUs, path: Astro.url.pathname },
]);
---

<Layout
  title={seo.title}
  description={seo.description}
  locale={locale}
  alternates={aboutAlternates()}
>
  <JsonLd slot="head" schema={schema} />

  <div class="container-site py-8 lg:py-12">
    <Breadcrumbs locale={locale} items={[{ label: strings.aboutUs }]} />

    <!-- Hero Section -->
    <header class="mt-8 max-w-3xl">
      <span class="inline-block rounded-full bg-surface-card px-3 py-1 text-caption font-semibold uppercase tracking-wider text-mute">
        {strings.aboutUs}
      </span>
      <h1 class="mt-3 text-display-lg text-ink">{strings.aboutH1}</h1>
      <p class="mt-4 text-heading-lg font-normal text-mute">
        {strings.aboutSubtitle}
      </p>
      <p class="mt-5 text-body-md text-body leading-relaxed" set:html={strings.aboutIntro} />
    </header>

    <!-- Stats Grid -->
    <div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
      <div class="rounded-md border border-hairline bg-canvas p-5 text-center">
        <span class="block text-display-lg font-bold text-primary">{countries.length}</span>
        <span class="mt-1 block text-body-sm font-medium text-mute">{strings.aboutStatCountries}</span>
      </div>
      <div class="rounded-md border border-hairline bg-canvas p-5 text-center">
        <span class="block text-display-lg font-bold text-primary">{totalEntries}+</span>
        <span class="mt-1 block text-body-sm font-medium text-mute">{strings.aboutStatTerms}</span>
      </div>
      <div class="rounded-md border border-hairline bg-canvas p-5 text-center">
        <span class="block text-display-lg font-bold text-primary">11</span>
        <span class="mt-1 block text-body-sm font-medium text-mute">{strings.aboutStatCategories}</span>
      </div>
      <div class="rounded-md border border-hairline bg-canvas p-5 text-center">
        <span class="block text-display-lg font-bold text-primary">9</span>
        <span class="mt-1 block text-body-sm font-medium text-mute">{strings.aboutStatLanguages}</span>
      </div>
    </div>

    <!-- Main Content -->
    <article class="mt-12 max-w-3xl space-y-10 text-body text-body-md leading-relaxed">
      <!-- Section 1 -->
      <section>
        <h2 class="text-heading-xl text-ink">{strings.aboutWhyHeading}</h2>
        <p class="mt-3" set:html={strings.aboutWhyP1} />
        <p class="mt-3" set:html={strings.aboutWhyP2} />
        <p class="mt-3">{strings.aboutWhyP3}</p>
      </section>

      <!-- Section 2: Four Pillars -->
      <section>
        <h2 class="text-heading-xl text-ink">{strings.aboutPillarsHeading}</h2>
        <p class="mt-3">
          {strings.aboutPillarsLead}
        </p>
        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <div class="rounded-md border border-hairline bg-canvas p-5">
            <h3 class="text-heading-md font-semibold text-ink">{strings.aboutPillar1Title}</h3>
            <p class="mt-2 text-body-sm text-body">
              {strings.aboutPillar1Body}
            </p>
          </div>
          <div class="rounded-md border border-hairline bg-canvas p-5">
            <h3 class="text-heading-md font-semibold text-ink">{strings.aboutPillar2Title}</h3>
            <p class="mt-2 text-body-sm text-body">
              {strings.aboutPillar2Body}
            </p>
          </div>
          <div class="rounded-md border border-hairline bg-canvas p-5">
            <h3 class="text-heading-md font-semibold text-ink">{strings.aboutPillar3Title}</h3>
            <p class="mt-2 text-body-sm text-body">
              {strings.aboutPillar3Body}
            </p>
          </div>
          <div class="rounded-md border border-hairline bg-canvas p-5">
            <h3 class="text-heading-md font-semibold text-ink">{strings.aboutPillar4Title}</h3>
            <p class="mt-2 text-body-sm text-body">
              {strings.aboutPillar4Body}
            </p>
          </div>
        </div>
      </section>

      <!-- Section 3: Countries Covered -->
      <section>
        <h2 class="text-heading-xl text-ink">{strings.aboutCulturesHeading}</h2>
        <p class="mt-3">
          {strings.aboutCulturesLead(countries.length)}
        </p>
        <div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
          {
            countries.map((country) => {
              const c = localizeCountry(country, locale);
              return (
                <a
                  href={countryPath(country, locale)}
                  class="focus-ring flex items-center gap-2 rounded-md border border-hairline bg-canvas p-2.5 text-body-sm font-semibold text-ink hover:border-primary hover:bg-surface-card transition-colors"
                >
                  <Flag code={c.flagCode} class="h-[1em] w-auto shrink-0 rounded-[2px]" />
                  <span>{c.name}</span>
                </a>
              );
            })
          }
        </div>
      </section>

      <!-- Section 4: Editorial Standards -->
      <section>
        <h2 class="text-heading-xl text-ink">{strings.aboutEditorialHeading}</h2>
        <p class="mt-3">
          {strings.aboutEditorialP1}
        </p>
        <p class="mt-3">
          {strings.aboutEditorialP2}
        </p>
      </section>

      <!-- CTA Card -->
      <section class="rounded-md border border-hairline bg-surface-card p-6">
        <h2 class="text-heading-xl text-ink">{strings.aboutConnectHeading}</h2>
        <p class="mt-2 text-body">
          {strings.aboutConnectBody}
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-3">
          <a
            href={contactPath(locale)}
            class="focus-ring inline-flex items-center gap-2 rounded-md bg-ink px-4 py-2.5 text-body-sm font-semibold text-canvas hover:bg-charcoal"
          >
            {strings.aboutContactBtn}
          </a>
          <a
            href={browsePath(locale)}
            class="focus-ring inline-flex items-center gap-2 rounded-md border border-hairline bg-canvas px-4 py-2.5 text-body-sm font-semibold text-ink hover:bg-surface-card"
          >
            {strings.aboutBrowseBtn}
          </a>
          <a
            href="mailto:techcommunity611@gmail.com"
            class="text-body-sm font-semibold text-primary hover:underline ml-2"
          >
            techcommunity611@gmail.com
          </a>
        </div>
      </section>

      <HeroLegalLinks locale={locale} class="mt-6" />
    </article>
  </div>
</Layout>
