---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import JsonLd from '../JsonLd.astro';
import { aboutPath, homePath } from '../../lib/urls';
import { chromeAlternates, countriesFor, entriesFor, loadSite } from '../../lib/site';
import { aboutSeo, SITE_URL } from '../../lib/seo';
import { absolute, breadcrumbs } from '../../lib/schema';
import { DEFAULT_LOCALE, type Locale } from '../../data/locales';
import { t } from '../../i18n/ui';
import { aboutContent } from '../../i18n/about';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const strings = t(locale);

const site = await loadSite();
const countries = countriesFor(site, locale);
const termCount = countries.reduce((n, c) => n + entriesFor(site, c.id, locale).length, 0);

const content = aboutContent(locale, termCount, countries.length);

const seo = aboutSeo(locale);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: seo.title,
    description: seo.description,
    url: absolute(Astro.url.pathname),
    publisher: { '@id': `${SITE_URL}/#organization` },
  },
  breadcrumbs([
    { name: strings.home, path: homePath(locale) },
    { name: strings.about, path: Astro.url.pathname },
  ]),
];
---

<Layout
  title={seo.title}
  description={seo.description}
  locale={locale}
  alternates={chromeAlternates(aboutPath)}
>
  <JsonLd slot="head" schema={schema} />

  <div class="container-site py-8 lg:py-12">
    <Breadcrumbs locale={locale} items={[{ label: strings.about }]} />

    <article class="mt-8 max-w-2xl">
      <h1 class="text-display-lg text-ink">{content.h1}</h1>
      <p class="mt-6 text-body-md text-body">{content.lead}</p>

      {
        content.sections.map((section) => (
          <>
            <h2 class="mt-10 text-heading-xl text-ink">{section.heading}</h2>
            {section.paragraphs?.map((p) => <p class="mt-4 text-body-md text-body">{p}</p>)}
            {section.bullets && (
              <ul class="mt-4 grid list-disc gap-3 pl-5 text-body-md text-body">
                {section.bullets.map((b) => (
                  <li>
                    <strong class="font-semibold text-ink">{b.lead}</strong> {b.rest}
                  </li>
                ))}
              </ul>
            )}
          </>
        ))
      }
    </article>
  </div>
</Layout>
