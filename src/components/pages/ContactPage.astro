---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import JsonLd from '../JsonLd.astro';
import HeroLegalLinks from '../HeroLegalLinks.astro';
import { homePath } from '../../lib/urls';
import { contactAlternates } from '../../lib/site';
import { breadcrumbs } from '../../lib/schema';
import { DEFAULT_LOCALE, type Locale } from '../../data/locales';
import { t } from '../../i18n/ui';
import { contactSeo } from '../../lib/seo';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const strings = t(locale);

const CONTACT_EMAIL = 'techcommunity611@gmail.com';

const seo = contactSeo(locale, CONTACT_EMAIL);

const schema = breadcrumbs([
  { name: strings.home, path: homePath(locale) },
  { name: strings.contactUs, path: Astro.url.pathname },
]);
---

<Layout
  title={seo.title}
  description={seo.description}
  locale={locale}
  alternates={contactAlternates()}
>
  <JsonLd slot="head" schema={schema} />

  <div class="container-site py-8 lg:py-12">
    <Breadcrumbs locale={locale} items={[{ label: strings.contactUs }]} />

    <!-- Hero Header -->
    <header class="mt-8 max-w-3xl">
      <span class="inline-block rounded-full bg-surface-card px-3 py-1 text-caption font-semibold uppercase tracking-wider text-mute">
        {strings.contactKicker}
      </span>
      <h1 class="mt-3 text-display-lg text-ink">{strings.contactUs}</h1>
      <p class="mt-3 text-heading-lg font-normal text-mute">
        {strings.contactSubtitle}
      </p>
      <p class="mt-4 text-body-md text-body leading-relaxed">
        {strings.contactIntro}
      </p>
    </header>

    <!-- Main Content: Direct Contact Card & Topics -->
    <div class="mt-10 max-w-3xl space-y-8">
      <!-- Prominent Email Callout Card -->
      <div class="rounded-md border-2 border-primary/20 bg-surface-card p-6 sm:p-8">
        <div class="flex items-center gap-3">
          <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-primary-wash text-primary">
            <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </div>
          <div>
            <p class="text-caption font-semibold uppercase tracking-wider text-mute">{strings.contactOfficialEmail}</p>
            <p class="text-heading-lg font-bold text-ink sm:text-heading-xl break-all">
              {CONTACT_EMAIL}
            </p>
          </div>
        </div>

        <p class="mt-4 text-body-sm text-body">
          {strings.contactEmailLead}
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <button
            type="button"
            id="copy-email-btn"
            data-email={CONTACT_EMAIL}
            data-copied={strings.contactCopied}
            class="focus-ring inline-flex items-center gap-2 rounded-md bg-ink px-4 py-2.5 text-body-sm font-semibold text-canvas hover:bg-charcoal transition-colors cursor-pointer"
          >
            <svg id="copy-icon" viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
            </svg>
            <span id="copy-text">{strings.contactCopyEmail}</span>
          </button>
        </div>
      </div>

      <!-- 4 Submission Categories -->
      <div>
        <h2 class="text-heading-md font-semibold text-ink">{strings.contactCategoriesHeading}</h2>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <div class="rounded-md border border-hairline bg-canvas p-4">
            <span class="text-heading-md text-primary font-bold">1</span>
            <h3 class="mt-1 text-body-md font-semibold text-ink">{strings.contactCat1Title}</h3>
            <p class="mt-1 text-caption text-mute">
              {strings.contactCat1Body}
            </p>
          </div>

          <div class="rounded-md border border-hairline bg-canvas p-4">
            <span class="text-heading-md text-primary font-bold">2</span>
            <h3 class="mt-1 text-body-md font-semibold text-ink">{strings.contactCat2Title}</h3>
            <p class="mt-1 text-caption text-mute">
              {strings.contactCat2Body}
            </p>
          </div>

          <div class="rounded-md border border-hairline bg-canvas p-4">
            <span class="text-heading-md text-primary font-bold">3</span>
            <h3 class="mt-1 text-body-md font-semibold text-ink">{strings.contactCat3Title}</h3>
            <p class="mt-1 text-caption text-mute">
              {strings.contactCat3Body}
            </p>
          </div>

          <div class="rounded-md border border-hairline bg-canvas p-4">
            <span class="text-heading-md text-primary font-bold">4</span>
            <h3 class="mt-1 text-body-md font-semibold text-ink">{strings.contactCat4Title}</h3>
            <p class="mt-1 text-caption text-mute">
              {strings.contactCat4Body}
            </p>
          </div>
        </div>
      </div>

      <!-- Response Time Box -->
      <div class="rounded-md border border-hairline-soft bg-surface-soft p-4 text-caption text-mute">
        <p>
          <strong>{strings.contactResponseTimeLabel}</strong> {strings.contactResponseTimeText}
        </p>
      </div>

      <HeroLegalLinks locale={locale} class="mt-6" />
    </div>
  </div>
</Layout>

<script is:inline>
  (function () {
    var copyBtn = document.getElementById('copy-email-btn');
    var copyText = document.getElementById('copy-text');

    if (copyBtn && copyText) {
      var email = copyBtn.getAttribute('data-email') || 'techcommunity611@gmail.com';
      var copiedMsg = copyBtn.getAttribute('data-copied') || 'Copied to Clipboard!';
      copyBtn.addEventListener('click', function () {
        navigator.clipboard.writeText(email).then(function () {
          var original = copyText.textContent;
          copyText.textContent = copiedMsg;
          setTimeout(function () {
            copyText.textContent = original;
          }, 2500);
        }).catch(function () {
          window.prompt('Copy email:', email);
        });
      });
    }
  })();
</script>
