---
import { DEFAULT_LOCALE, type Locale } from '../data/locales';
import { homePath } from '../lib/urls';
import { t } from '../i18n/ui';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
  locale?: Locale;
}

const { items, locale = DEFAULT_LOCALE } = Astro.props;
const strings = t(locale);
---

<nav aria-label={strings.breadcrumb} class="text-caption">
  <ol class="flex flex-wrap items-center gap-1.5 text-mute">
    <li>
      <a href={homePath(locale)} class="focus-ring rounded-sm hover:text-ink hover:underline"
        >{strings.home}</a
      >
    </li>
    {
      items.map((item, i) => (
        <>
          <li aria-hidden="true" class="text-stone">
            /
          </li>
          <li>
            {item.href && i < items.length - 1 ? (
              <a href={item.href} class="focus-ring rounded-sm hover:text-ink hover:underline">
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="text-charcoal">
                {item.label}
              </span>
            )}
          </li>
        </>
      ))
    }
  </ol>
</nav>
