---
import { LOCALES, localeConfig, type Locale } from '../data/locales';
import { homePath } from '../lib/urls';
import { t } from '../i18n/ui';
import type { Alternate } from '../lib/site';
import FlagGroup from './FlagGroup.astro';

interface Props {
  locale: Locale;
  /** This page in its other languages, when it has any. */
  alternates?: Alternate[];
  /**
   * Render the languages as a flat list instead of a disclosure menu. Used in
   * the mobile drawer, which is already a menu and should not nest a second one.
   */
  flat?: boolean;
}

const { locale, alternates = [], flat = false } = Astro.props;
const strings = t(locale);
const current = localeConfig(locale);

/**
 * Prefer the equivalent page; fall back to the locale's home page.
 *
 * Dropping a reader on a 404 because the page they were looking at isn't
 * translated is the worst of the three options, and silently hiding the
 * switcher is the second worst — it makes the site look monolingual. Landing
 * them on that language's home page is honest about what exists.
 */
const hrefFor = (code: Locale) =>
  alternates.find((a) => a.locale === code && a.hreflang !== 'x-default')?.path ?? homePath(code);

const options = LOCALES.map((l) => ({ ...l, href: hrefFor(l.code) }));

const linkClass =
  'focus-ring block rounded-md px-2.5 py-2 text-body-sm font-semibold text-mute hover:bg-surface-card hover:text-ink';
---

{
  /*
   * Nine languages is past the point where a row of endonyms fits in a header,
   * so the desktop switcher is a details/summary disclosure — no JS, and the
   * whole list is still in the HTML for a crawler to follow. The mobile drawer
   * passes `flat`, because it is already an open menu.
   */
}
{
  flat ? (
    <nav aria-label={strings.language}>
      <h2 class="text-caption font-semibold tracking-wide text-mute uppercase">
        {strings.language}
      </h2>
      <ul class="mt-2 grid grid-cols-2 gap-1">
        {options.map((o) => (
          <li>
            {o.code === locale ? (
              <span
                aria-current="true"
                class="flex items-center gap-2 rounded-md px-2.5 py-2 text-body-sm font-bold text-ink"
                lang={o.hreflang}
              >
                <FlagGroup {...o} />
                {o.endonym}
              </span>
            ) : (
              <a
                href={o.href}
                hreflang={o.hreflang}
                lang={o.hreflang}
                rel="alternate"
                class={`flex items-center gap-2 ${linkClass}`}
              >
                <FlagGroup {...o} />
                {o.endonym}
              </a>
            )}
          </li>
        ))}
      </ul>
    </nav>
  ) : (
    <details class="group relative">
      <summary
        class="focus-ring flex cursor-pointer list-none items-center gap-1.5 rounded-md px-2.5 py-2 text-body-sm font-semibold text-ink [&::-webkit-details-marker]:hidden"
        aria-label={strings.language}
      >
        <FlagGroup {...current} />
        <span lang={current.hreflang}>{current.endonym}</span>
        <svg
          viewBox="0 0 24 24"
          class="size-4 text-mute transition-transform group-open:rotate-180"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M6 9l6 6 6-6" />
        </svg>
      </summary>
      <nav
        aria-label={strings.language}
        class="absolute end-0 z-50 mt-1 min-w-40 rounded-md border border-hairline bg-canvas p-1 shadow-lg"
      >
        <ul class="grid">
          {options.map((o) => (
            <li>
              {o.code === locale ? (
                <span
                  aria-current="true"
                  class="flex items-center gap-2 rounded-md px-2.5 py-2 text-body-sm font-bold text-ink"
                  lang={o.hreflang}
                >
                  <FlagGroup {...o} />
                  {o.endonym}
                </span>
              ) : (
                <a
                  href={o.href}
                  hreflang={o.hreflang}
                  lang={o.hreflang}
                  rel="alternate"
                  class={`flex items-center gap-2 ${linkClass}`}
                >
                  <FlagGroup {...o} />
                  {o.endonym}
                </a>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </details>
  )
}
